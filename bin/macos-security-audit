#!/usr/bin/env bash
#
# macos-security-audit
# Comprehensive macOS security audit script.
# Produces a Markdown (or JSON) report covering disk encryption, firewall, SIP,
# Gatekeeper, network exposure, sharing services, user accounts,
# persistence mechanisms, credentials, and more.
#
# Author:  fexxdev
# License: MIT
# Source:  https://github.com/fexxdev/macos_secuirty_audit
#
# Usage:
#   macos-security-audit                          # run with default output
#   macos-security-audit --output report.md       # custom output path
#   macos-security-audit --show-fix               # show fix commands after each finding
#   macos-security-audit --json                   # output as JSON
#   macos-security-audit --category encryption    # run only encryption checks
#   macos-security-audit --quiet                  # print only the grade
#   macos-security-audit --redact                 # mask the serial number in the report
#   macos-security-audit --online                 # allow the one network-touching check
#   macos-security-audit --list-checks            # show all checks
#
# The report is a Markdown file you can read, share, or diff over time.
#
# The audit is READ-ONLY and OFFLINE by default: it never changes system state
# and never makes a network request unless --online is passed explicitly.
#
# Setting MSA_LIB_MODE=1 sources this file without running an audit, so the
# test suite can unit-test the helper functions in isolation.

set -euo pipefail

VERSION="3.1.0"
MSA_LIB_MODE="${MSA_LIB_MODE:-0}"

# ── Colours / symbols for terminal output ────────────────────────────
if [[ -t 1 ]]; then
    RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'
else
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
fi
PASS="${GREEN}PASS${NC}"; FAIL="${RED}FAIL${NC}"; WARN="${YELLOW}WARN${NC}"

# ── Output modes ─────────────────────────────────────────────────────
JSON_MODE=false
QUIET_MODE=false
ONLINE_MODE=false
REDACT_MODE=false
CATEGORY_FILTER=""
PARTIAL_AUDIT=false

###############################################################################
# CHECK REGISTRY — the single source of truth
#
# Format: "<number>|<category>|<title>|<function>"
#
# Adding a check = write the check_* function + append one line here. The
# number, the category filter, --list-checks, --help and the run order are all
# derived from this array; nothing else needs to be touched.
###############################################################################
CHECKS=(
    "1|encryption|Disk Encryption (FileVault)|check_encryption_filevault"
    "2|encryption|Time Machine Backup & Encryption|check_encryption_timemachine"
    "3|system|System Integrity Protection (SIP)|check_system_sip"
    "4|system|Gatekeeper & Secure Boot|check_system_gatekeeper"
    "5|system|Lockdown Mode|check_system_lockdown"
    "6|system|Rapid Security Response|check_system_rsr"
    "7|system|XProtect Definitions|check_system_xprotect"
    "8|system|Kernel Extensions|check_system_kext"
    "9|system|Find My Mac|check_system_findmymac"
    "10|network|Firewall & Stealth Mode|check_network_firewall"
    "11|network|Network Exposure|check_network_exposure"
    "12|network|DNS & Network|check_network_dns"
    "13|network|Wi-Fi Auto-Join for Open Networks|check_network_wifi"
    "14|network|Internet Sharing|check_network_internet_sharing"
    "15|network|Wake on Network Access|check_network_wake"
    "16|sharing|Sharing Services|check_sharing_services"
    "17|sharing|Remote Apple Events|check_sharing_remote_apple_events"
    "18|sharing|Content Caching|check_sharing_content_caching"
    "19|sharing|Printer Sharing|check_sharing_printer"
    "20|sharing|Media Sharing|check_sharing_media"
    "21|sharing|Handoff|check_sharing_handoff"
    "22|auth|User Accounts & Authentication|check_auth_users"
    "23|auth|SSH Configuration|check_auth_ssh"
    "24|auth|Screen Saver Timeout|check_auth_screensaver"
    "25|auth|Login Window Configuration|check_auth_login_window"
    "26|auth|Touch ID|check_auth_touchid"
    "27|auth|USB Restricted Mode|check_auth_usb"
    "28|privacy|Location Services|check_privacy_location"
    "29|privacy|Analytics & Telemetry Sharing|check_privacy_analytics"
    "30|privacy|Bluetooth Discoverability|check_privacy_bluetooth"
    "31|privacy|Siri Voice Trigger|check_privacy_siri"
    "32|software|Software Updates|check_software_updates"
    "33|software|Installed Software & Persistence|check_software_review"
    "34|software|Safari Safe File Auto-Open|check_software_safari"
    "35|software|Secure Keyboard Entry (Terminal)|check_software_secure_keyboard"
    "36|software|Docker Daemons|check_software_docker"
    "37|encryption|FileVault Recovery Key|check_encryption_recovery_key"
    "38|system|Configuration Profiles|check_system_profiles"
    "39|system|MRT / XProtect Remediator|check_system_mrt"
    "40|auth|Password Policy|check_auth_password_policy"
    "41|privacy|Privacy Permissions (TCC)|check_privacy_tcc"
    "42|software|Safari Privacy & Security|check_software_safari_privacy"
    "43|system|Trusted Root Certificates|check_system_trusted_roots"
    "44|software|Startup & Login Items|check_software_startup_items"
    "45|software|Shell Startup Files|check_software_shell_rc"
    "46|auth|Sudo Configuration|check_auth_sudoers"
    "47|auth|Login Authorization Plugins|check_auth_authplugins"
    "48|software|Browser Extensions|check_software_browser_extensions"
)

TOTAL_CHECKS=${#CHECKS[@]}

# Category order used by --help / --list-checks (declaration order in CHECKS).
CATEGORIES=(encryption system network sharing auth privacy software)

# check_field <number> <1=category|2=title|3=function>
check_field() {
    local want="$1" field="$2" entry num
    for entry in "${CHECKS[@]}"; do
        num="${entry%%|*}"
        if [[ "$num" == "$want" ]]; then
            case "$field" in
                1) entry="${entry#*|}"; printf '%s' "${entry%%|*}" ;;
                2) entry="${entry#*|}"; entry="${entry#*|}"; printf '%s' "${entry%%|*}" ;;
                3) printf '%s' "${entry##*|}" ;;
            esac
            return 0
        fi
    done
    printf 'unknown'
    return 1
}

# ── list_checks ──────────────────────────────────────────────────────
list_checks() {
    local entry num cat title
    printf " %-4s %-14s %s\n" "#" "Category" "Check"
    printf " %-4s %-14s %s\n" "---" "--------------" "------------------------------------"
    for entry in "${CHECKS[@]}"; do
        IFS='|' read -r num cat title _ <<< "$entry"
        printf " %-4s %-14s %s\n" "$num" "$cat" "$title"
    done
}

# Grouped listing used by --help
list_checks_grouped() {
    local cat entry num ecat title
    for cat in "${CATEGORIES[@]}"; do
        printf "\n  %s:\n" "$(tr '[:lower:]' '[:upper:]' <<< "${cat:0:1}")${cat:1}"
        for entry in "${CHECKS[@]}"; do
            IFS='|' read -r num ecat title _ <<< "$entry"
            [[ "$ecat" == "$cat" ]] && printf "    %2s  %s\n" "$num" "$title"
        done
    done
}

# ── Usage ─────────────────────────────────────────────────────────────
usage() {
    cat <<EOF
macos-security-audit v${VERSION}

Comprehensive macOS security audit with Markdown report generation.
Read-only and offline: it never changes system state, and makes no network
request unless --online is passed.

USAGE:
    macos-security-audit [OPTIONS]

OPTIONS:
    --help            Show this help message
    --version         Print version and exit
    --output FILE     Custom report path (default: ./security-audit-YYYY-MM-DD.md)
    --show-fix        After each finding, print fix command(s) in a copy-pasteable block
    --json            Output report as JSON instead of Markdown
    --category CAT    Run only checks in given categories (comma-separated)
                      Categories: $(IFS=,; printf '%s' "${CATEGORIES[*]}")
    --baseline FILE   Compare against a previous --json report and report what
                      changed. Does not affect the score or the exit code.
    --quiet           Suppress terminal output, print only the grade
    --no-color        Disable ANSI color codes in terminal output
    --redact          Mask the hardware serial number in the report
    --online          Allow the single check that queries Apple's update servers
    --list-checks     List all checks with category and description

    Long options also accept the --opt=value form.

EXIT CODES:
    0   grade A+ … B-
    1   grade C+ … C-
    2   grade D+ … F
    64  invalid usage

EXAMPLES:
    macos-security-audit
    macos-security-audit --show-fix
    macos-security-audit --json --output report.json
    macos-security-audit --category encryption,network
    macos-security-audit --quiet
    macos-security-audit --list-checks

CHECKS PERFORMED ($TOTAL_CHECKS):
EOF
    list_checks_grouped
    exit 0
}

# ── Parse arguments ──────────────────────────────────────────────────
EX_USAGE=64

DATE_STAMP=$(date +%Y-%m-%d)
OUTPUT_FILE=""
SHOW_FIX=false
BASELINE_FILE=""

die_usage() {
    printf '%berror:%b %s\n' "$RED" "$NC" "$1" >&2
    printf "Run 'macos-security-audit --help' for usage.\n" >&2
    exit "$EX_USAGE"
}

no_color() {
    RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
    PASS="PASS"; FAIL="FAIL"; WARN="WARN"
}

# Skipped entirely in library mode: a harness that sources this file has its own
# argv, and parsing it here would either misfire or exit the harness.
if [[ "$MSA_LIB_MODE" != "1" ]]; then
while [[ $# -gt 0 ]]; do
    # Accept both "--opt value" and "--opt=value".
    opt="$1"; optval=""; has_optval=false
    if [[ "$opt" == --*=* ]]; then
        optval="${opt#*=}"; opt="${opt%%=*}"; has_optval=true
    fi
    case "$opt" in
        --help)        usage ;;
        --version)     echo "macos-security-audit v${VERSION}"; exit 0 ;;
        --list-checks) list_checks; exit 0 ;;
        --show-fix)    SHOW_FIX=true; shift ;;
        --json)        JSON_MODE=true; shift ;;
        --quiet)       QUIET_MODE=true; shift ;;
        --online)      ONLINE_MODE=true; shift ;;
        --redact)      REDACT_MODE=true; shift ;;
        --no-color)    no_color; shift ;;
        --output)
            if $has_optval; then
                OUTPUT_FILE="$optval"; shift
            else
                [[ $# -ge 2 ]] || die_usage "--output requires a FILE argument"
                OUTPUT_FILE="$2"; shift 2
            fi
            [[ -n "$OUTPUT_FILE" ]] || die_usage "--output requires a non-empty FILE argument"
            ;;
        --baseline)
            if $has_optval; then
                BASELINE_FILE="$optval"; shift
            else
                [[ $# -ge 2 ]] || die_usage "--baseline requires a FILE argument"
                BASELINE_FILE="$2"; shift 2
            fi
            [[ -n "$BASELINE_FILE" ]] || die_usage "--baseline requires a non-empty FILE argument"
            ;;
        --category)
            if $has_optval; then
                CATEGORY_FILTER="$optval"; shift
            else
                [[ $# -ge 2 ]] || die_usage "--category requires a CAT argument"
                CATEGORY_FILTER="$2"; shift 2
            fi
            [[ -n "$CATEGORY_FILTER" ]] || die_usage "--category requires a non-empty CAT argument"
            ;;
        *)
            die_usage "unknown option: $1"
            ;;
    esac
done
fi

# ── Validate --category against the registry ─────────────────────────
if [[ -n "$CATEGORY_FILTER" ]]; then
    # Normalise: lowercase, drop whitespace, reject anything not in CATEGORIES.
    CATEGORY_FILTER=$(tr '[:upper:]' '[:lower:]' <<< "$CATEGORY_FILTER" | tr -d '[:space:]')
    _valid=""
    IFS=',' read -r -a _requested <<< "$CATEGORY_FILTER"
    for _cat in "${_requested[@]}"; do
        [[ -z "$_cat" ]] && continue
        _found=false
        for _known in "${CATEGORIES[@]}"; do
            [[ "$_cat" == "$_known" ]] && { _found=true; break; }
        done
        $_found || die_usage "unknown category: $_cat (valid: $(IFS=,; printf '%s' "${CATEGORIES[*]}"))"
        _valid="${_valid:+$_valid,}$_cat"
    done
    [[ -n "$_valid" ]] || die_usage "--category requires at least one category"
    CATEGORY_FILTER="$_valid"
fi

# ── Validate --baseline ──────────────────────────────────────────────
# Checked before the audit runs, not after: finding out that the baseline was a
# typo is worth 40 seconds of someone's time.
if [[ -n "$BASELINE_FILE" && "$MSA_LIB_MODE" != "1" ]]; then
    [[ -e "$BASELINE_FILE" ]] || die_usage "baseline file does not exist: $BASELINE_FILE"
    [[ -f "$BASELINE_FILE" && -r "$BASELINE_FILE" ]] || die_usage "baseline file is not a readable file: $BASELINE_FILE"
    grep -q '"findings"' "$BASELINE_FILE" 2>/dev/null \
        || die_usage "baseline file is not a macos-security-audit JSON report (run with --json to produce one): $BASELINE_FILE"
fi

# Set default output file based on mode
if [[ -z "$OUTPUT_FILE" ]]; then
    if $JSON_MODE; then
        OUTPUT_FILE="security-audit-${DATE_STAMP}.json"
    else
        OUTPUT_FILE="security-audit-${DATE_STAMP}.md"
    fi
fi

# Fail before running a full audit if the report could not be written anyway.
# An existing target only needs to be writable itself — that is what makes
# `--output /dev/null` work even though /dev is not writable.
if [[ "$MSA_LIB_MODE" != "1" ]]; then
    if [[ -d "$OUTPUT_FILE" ]]; then
        die_usage "output path is a directory: $OUTPUT_FILE"
    elif [[ -e "$OUTPUT_FILE" ]]; then
        [[ -w "$OUTPUT_FILE" ]] || die_usage "output file is not writable: $OUTPUT_FILE"
    else
        _out_dir=$(dirname -- "$OUTPUT_FILE")
        [[ -d "$_out_dir" ]] || die_usage "output directory does not exist: $_out_dir"
        [[ -w "$_out_dir" ]] || die_usage "output directory is not writable: $_out_dir"
    fi
fi

# ── Category filtering ──────────────────────────────────────────────
check_category() { check_field "$1" 1; }
check_title()    { check_field "$1" 2; }

should_run_check() {
    [[ -z "$CATEGORY_FILTER" ]] && return 0
    local cat
    cat=$(check_category "$1")
    case ",$CATEGORY_FILTER," in
        *",$cat,"*) return 0 ;;
    esac
    return 1
}

# Count checks that will actually run
count_active_checks() {
    local count=0 entry num
    for entry in "${CHECKS[@]}"; do
        num="${entry%%|*}"
        if should_run_check "$num"; then
            count=$((count + 1))
        fi
    done
    printf '%s' "$count"
}

# ── Quiet-mode aware output ──────────────────────────────────────────
# NOTE: $1 is a printf FORMAT string — never pass unvalidated data as $1.
qprint() {
    if ! $QUIET_MODE; then
        # shellcheck disable=SC2059  # forwarding a caller-supplied format is the point
        printf "$@"
    fi
}

qecho() {
    if ! $QUIET_MODE; then
        echo "$@"
    fi
}

# ── JSON helpers ─────────────────────────────────────────────────────
json_escape() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\t'/\\t}"
    s="${s//$'\r'/\\r}"
    printf '%s' "$s"
}

# ── Findings store ───────────────────────────────────────────────────
# Every finding is recorded exactly once, by the severity helper that reports
# it; the Markdown and JSON renderers both read from here. show_fix() attaches
# its command block to the finding recorded just before it, so a fix can never
# drift out of sync with the finding it belongs to.
declare -a F_NUM=() F_CAT=() F_TITLE=() F_SEV=() F_SUMMARY=() F_DETAIL=() F_FIX=()

record_finding() {
    F_NUM+=("$CURRENT_CHECK_NUM")
    F_CAT+=("$CURRENT_CHECK_CATEGORY")
    F_TITLE+=("$CURRENT_CHECK_TITLE")
    F_SEV+=("$1")
    F_SUMMARY+=("$2")
    F_DETAIL+=("${3:-}")
    F_FIX+=("")
}

# Prints a copy-pasteable fix block (with --show-fix) and stores it on the
# finding that was just recorded.
show_fix() {
    local description="$1" cmd fix_text
    shift
    fix_text="$description"
    for cmd in "$@"; do
        fix_text="${fix_text}"$'\n'"${cmd}"
    done
    if (( ${#F_FIX[@]} > 0 )); then
        F_FIX[${#F_FIX[@]} - 1]="$fix_text"
    fi
    if $SHOW_FIX && ! $QUIET_MODE; then
        echo ""
        printf "  %b%bFIX:%b %s\n" "$BOLD" "$YELLOW" "$NC" "$description"
        for cmd in "$@"; do
            printf "  %b\$%b %s\n" "$CYAN" "$NC" "$cmd"
        done
    fi
}

# ── Accumulators for the report ──────────────────────────────────────
declare -a PASSES=()
declare -a CRITICALS=()
declare -a HIGHS=()
declare -a MEDIUMS=()

SCORE=100
CURRENT_CHECK_NUM=0
CURRENT_CHECK_TITLE=""
CURRENT_CHECK_CATEGORY=""
CHECKS_RUN=0

pass() {
    PASSES+=("$1")
    qprint "  ${PASS}  %s\n" "$1"
    record_finding "pass" "$1" ""
}

critical() {
    CRITICALS+=("$(printf '%s\n\n%s' "$1" "${2:-}")")
    SCORE=$((SCORE - 8))
    qprint "  ${FAIL}  %s\n" "$1"
    record_finding "critical" "$1" "${2:-}"
}

high() {
    HIGHS+=("$(printf '%s\n\n%s' "$1" "${2:-}")")
    SCORE=$((SCORE - 4))
    qprint "  ${WARN}  %s\n" "$1"
    record_finding "high" "$1" "${2:-}"
}

medium() {
    MEDIUMS+=("$(printf '%s\n\n%s' "$1" "${2:-}")")
    SCORE=$((SCORE - 2))
    qprint "  ${WARN}  %s\n" "$1"
    record_finding "medium" "$1" "${2:-}"
}

letter_grade() {
    local s=$1
    (( s < 0 )) && s=0
    if   (( s >= 95 )); then echo "A+"
    elif (( s >= 90 )); then echo "A"
    elif (( s >= 85 )); then echo "A-"
    elif (( s >= 80 )); then echo "B+"
    elif (( s >= 75 )); then echo "B"
    elif (( s >= 70 )); then echo "B-"
    elif (( s >= 65 )); then echo "C+"
    elif (( s >= 60 )); then echo "C"
    elif (( s >= 55 )); then echo "C-"
    elif (( s >= 50 )); then echo "D+"
    elif (( s >= 45 )); then echo "D"
    elif (( s >= 40 )); then echo "D-"
    else echo "F"
    fi
}

# ── Baseline comparison (--baseline) ─────────────────────────────────
# One audit tells you the state of the machine. Two audits tell you what
# changed since — a listening port that was not there last week, a root CA that
# appeared overnight, SIP that got turned off and nobody said so.
#
# The diff never moves the score and never changes the exit code. "This appeared
# since Tuesday" is a fact about time, not about how hardened the machine is
# right now, and a score that drifts with the age of the baseline file would be
# meaningless. The audit result stands on its own; the diff sits beside it.
#
# Both sides are reduced to one line per finding — "<check>|<severity>|<summary>"
# — with passes excluded, because a check flipping from fail to pass shows up as
# the failure disappearing and does not need to be listed twice. Comparison
# happens in JSON-escaped form on both sides so that a summary containing a
# quote compares equal to itself; unescaping is done only for display.

# Escapes are undone in one left-to-right pass. Doing it as a sequence of
# substitutions would turn a literal backslash-n in a path into a newline.
json_unescape() {
    local s="$1" out="" c
    while [[ -n "$s" ]]; do
        c="${s:0:1}"
        if [[ "$c" == "\\" && -n "${s:1:1}" ]]; then
            case "${s:1:1}" in
                n) out="${out}"$'\n' ;;
                t) out="${out}"$'\t' ;;
                r) out="${out}"$'\r' ;;
                *) out="${out}${s:1:1}" ;;
            esac
            s="${s:2}"
        else
            out="${out}${c}"
            s="${s:1}"
        fi
    done
    printf '%s' "$out"
}

# render_json writes each finding on a single line, which is what makes this a
# sed expression instead of a JSON parser the tool is not allowed to depend on.
# The anchors are the field names either side of the value, and every one of
# them would have been escaped had it appeared inside a string.
baseline_findings() {
    sed -n 's/.*"check_number":\([0-9][0-9]*\),.*"severity":"\([a-z]*\)","summary":"\(.*\)","detail":".*/\1|\2|\3/p' "$1" 2>/dev/null \
        | grep -v '|pass|' || true
}

# A --category run must not report every unrun check as "resolved". The baseline
# is filtered through the same predicate the audit itself used.
baseline_findings_active() {
    local line num
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        num="${line%%|*}"
        should_run_check "$num" && printf '%s\n' "$line"
    done < <(baseline_findings "$1")
    return 0
}

current_findings() {
    local i
    for (( i = 0; i < ${#F_SEV[@]}; i++ )); do
        [[ "${F_SEV[$i]}" == "pass" ]] && continue
        printf '%s|%s|%s\n' "${F_NUM[$i]}" "${F_SEV[$i]}" "$(json_escape "${F_SUMMARY[$i]}")"
    done
}

# Top-level scalars only — score, grade, timestamp. render_json indents them by
# exactly two spaces; anything nested under "machine" or "summary" is deeper and
# is deliberately out of reach of this pattern.
baseline_meta() {
    sed -n "s/^  \"$2\": \"\{0,1\}\([^\",]*\)\"\{0,1\},\{0,1\}\$/\1/p" "$1" 2>/dev/null | head -1
}

# "12|high|External IPs found in /etc/hosts" → "[12] HIGH  External IPs …"
format_diff_line() {
    local line="$1" num sev summary
    num="${line%%|*}"
    line="${line#*|}"
    sev="${line%%|*}"
    summary="${line#*|}"
    printf '[%s] %s  %s' "$num" "$(tr '[:lower:]' '[:upper:]' <<< "$sev")" "$(json_unescape "$summary")"
}

diff_line_field() {
    local line="$1"
    case "$2" in
        num)     printf '%s' "${line%%|*}" ;;
        sev)     line="${line#*|}"; printf '%s' "${line%%|*}" ;;
        summary) line="${line#*|}"; printf '%s' "${line#*|}" ;;
    esac
}

declare -a BASELINE_NEW=() BASELINE_GONE=()
BASELINE_SCORE=""
BASELINE_GRADE=""
BASELINE_TIMESTAMP=""

# ── Attack chains ────────────────────────────────────────────────────
# Some findings are worse together than apart. FileVault off is bad and
# auto-login is bad, but the two together mean whoever picks the machine up is
# at your desktop, and whoever pulls the drive out reads it on their own — both
# barriers gone at once. Scoring each check in isolation has no way to say that.
#
# A chain deducts nothing. Every component has already cost the score what it
# costs, and charging twice for the same two findings would make the grade
# depend on how many chains happen to have been written down. What a chain
# changes is the order you fix things in, which is the part the severity column
# was never able to tell you.
#
# Each chain keys on the exact summary text of the findings it combines, so a
# chain can only fire on a finding that was actually recorded.

declare -a CHAIN_TITLES=() CHAIN_BODIES=()

has_finding() {
    local want_num="$1" want_sub="$2" i
    for (( i = 0; i < ${#F_NUM[@]}; i++ )); do
        [[ "${F_NUM[$i]}" == "$want_num" ]] || continue
        [[ "${F_SEV[$i]}" == "pass" ]] && continue
        case "${F_SUMMARY[$i]}" in
            *"$want_sub"*) return 0 ;;
        esac
    done
    return 1
}

add_chain() {
    CHAIN_TITLES+=("$1")
    CHAIN_BODIES+=("$2")
}

evaluate_attack_chains() {
    if has_finding 1 "FileVault is OFF" && has_finding 22 "Auto-login is ENABLED"; then
        add_chain "Unencrypted disk, and no password at boot" \
"FileVault is off (check 1) and auto-login is on (check 22). Powering the Mac on lands
straight at your desktop with nothing typed, and pulling the drive out gives the same
data to any other machine. The two findings remove the two different barriers, so
neither one is a fallback for the other.
Fix FileVault first: it is the one that still protects the data when the Mac is off."
    fi

    if has_finding 16 "Remote Login (SSH) is enabled" && has_finding 10 "Firewall is DISABLED"; then
        add_chain "SSH is listening and nothing is filtering it" \
"SSH is accepting connections (check 16) and the application firewall is off (check 10).
On a home network that is one exposed service; on café or hotel Wi-Fi it is one reachable
from every other device on the segment, with no per-application rule in the way.
Turning the firewall on is the smaller change of the two and does not cost you SSH."
    fi

    if has_finding 3 "SIP is DISABLED" && has_finding 4 "Gatekeeper is DISABLED"; then
        add_chain "Nothing checks what runs, and nothing protects the system once it does" \
"SIP is off (check 3) and Gatekeeper is off (check 4). Gatekeeper is what stops unsigned
code from running in the first place; SIP is what stops code that is already running from
modifying the system itself. With both off, an unsigned binary launched by accident can
write to system locations and persist there.
Gatekeeper is re-enabled in seconds and does not require a reboot; SIP does."
    fi

    if has_finding 43 "trusted as a root CA" && has_finding 12 "External/production IPs found in /etc/hosts"; then
        add_chain "A trusted root CA plus hardcoded infrastructure addresses" \
"A certificate is trusted as a root CA (check 43) and /etc/hosts pins hostnames to
non-local IPs (check 12). Whoever holds that CA key can issue a certificate for any
hostname your Mac trusts, and /etc/hosts already documents which hostnames are worth
issuing one for and where they point.
Neither is a compromise on its own. Together they are a map plus the key to use it."
    fi

    if has_finding 33 "mkcert root CA key has loose permissions" && has_finding 43 "trusted as a root CA"; then
        add_chain "The trusted CA's private key is readable" \
"mkcert's root CA private key has permissions wider than 600 (check 33), and a
certificate is trusted as a root CA on this machine (check 43). Any process running as
your user — a dependency in a build script included — can read that key and mint a
certificate this Mac will accept for any domain, with no warning shown.
Tighten the key to 600. If mkcert is no longer in use, 'mkcert -uninstall' removes the CA."
    fi
}

# ── Helpers ──────────────────────────────────────────────────────────
cmd_exists()  { command -v "$1" &>/dev/null; }
daemon_loaded() { launchctl list "$1" &>/dev/null; }

# "1 day" not "1 days" — a stray plural makes the report read like a draft.
days_label() { if (( $1 == 1 )); then printf '1 day'; else printf '%s days' "$1"; fi; }

# "Siri Data Sharing Opt-In Status" is an enum, not a boolean, and this check
# had its polarity backwards — it flagged 2 as ON when 2 is what macOS writes
# when you opt *out*. Confirmed against System Settings > Privacy & Security >
# Analytics & Improvements on a machine reading 2: the toggle was off.
#     unset / 0 = never asked
#     1         = opted in  (sharing ON)
#     2         = opted out (sharing OFF)
# Only 1 is reported. An unrecognised value is not evidence that anything is
# being shared, and treating "not the value I expected" as ON is exactly what
# produced the false positive.
siri_sharing_state() {
    case "$1" in
        1) printf 'on' ;;
        2) printf 'off' ;;
        0|"") printf 'not-asked' ;;
        *) printf 'unknown' ;;
    esac
}

# socketfilterfw prints one of three sentences, and only one of them contains
# the word "enabled":
#     Firewall is disabled. (State = 0)
#     Firewall is enabled. (State = 1)
#     Firewall is blocking all non-essential incoming connections. (State = 2)
# Matching on "enabled" therefore reported state 2 — the *strictest* setting —
# as a CRITICAL finding. The "(State = N)" suffix is the only stable thing to
# key on; the sentences are fallback for releases that omit it.
firewall_state() {
    local out="$1" n
    n=$(printf '%s\n' "$out" | sed -n 's/.*(State = \([0-9][0-9]*\)).*/\1/p')
    n=${n%%$'\n'*}
    if [[ -n "$n" ]]; then printf '%s' "$n"; return; fi
    case "$out" in
        *disabled*) printf '0' ;;
        *blocking*) printf '2' ;;
        *enabled*)  printf '1' ;;
        *)          printf 'unknown' ;;
    esac
}

# `security dump-trust-settings` prints a Result Type per policy, and only two
# of them grant trust — in very different amounts:
#     kSecTrustSettingsResultTrustRoot   this certificate is a CA, so every
#                                        certificate it signs is trusted too
#     kSecTrustSettingsResultTrustAsRoot this one certificate is trusted, and
#                                        nothing it signs inherits that
#     kSecTrustSettingsResultDeny        explicitly distrusted — a *good* setting
#     kSecTrustSettingsResultUnspecified no override; the system default applies
# Deny is the one setting here that improves security, so reporting it as a risk
# would flag exactly the wrong thing. The mapping is explicit and anything
# unrecognised stays "other" rather than being assumed to grant trust.
#     (no Result Type line)         the user domain prints trust settings with
#                                   no Result Type at all — observed on macOS 26
# Deny is the one setting here that improves security, so reporting it as a risk
# would flag exactly the wrong thing. A missing Result Type is reported as
# "unstated" rather than assumed: Apple documents an absent value as defaulting
# to TrustRoot, but this tool has not confirmed that on a live certificate, and
# guessing that something grants root trust is how a false alarm gets written.
trust_result_risk() {
    case "$1" in
        "")           printf 'unstated' ;;
        none)         printf 'none' ;;
        *TrustAsRoot) printf 'leaf' ;;
        *TrustRoot)   printf 'root' ;;
        *Deny)        printf 'deny' ;;
        *Unspecified) printf 'unspecified' ;;
        *)            printf 'other' ;;
    esac
}

# A certificate carries one trust setting per policy, and they can disagree —
# SSL denied, S/MIME trusted as a root. Ranking them lets the strongest win, so
# a certificate is never described by whichever setting happened to be parsed
# last. Higher rank = more trust granted.
trust_risk_rank() {
    case "$1" in
        root)        printf '5' ;;
        leaf)        printf '4' ;;
        deny)        printf '3' ;;
        unspecified) printf '2' ;;
        unstated)    printf '1' ;;
        *)           printf '0' ;;   # 'none' and anything unrecognised
    esac
}

# Mechanisms in the login authorization chain are "<provider>:<name>[,privileged]".
# Everything Apple ships uses one of these providers; a third-party plugin appears
# under its own bundle name. A mechanism in this chain runs inside the login
# window — the process the password is typed into — so an unexpected provider is
# worth reading even when the bundle is signed.
APPLE_LOGIN_PROVIDERS=(builtin loginwindow PKINITMechanism HomeDirMechanism MCXMechanism CryptoTokenKit)

login_mechanism_is_apple() {
    local provider="${1%%:*}" known
    for known in "${APPLE_LOGIN_PROVIDERS[@]}"; do
        [[ "$provider" == "$known" ]] && return 0
    done
    return 1
}

# A shell startup file runs on every new terminal, so anyone who can write to it
# gets code execution as you. The mode comes from stat as octal digits and the
# two write bits are tested arithmetically — string-matching a 9-character
# listing is how "-rw-rw-r--" and "-rw-r--rw-" end up treated the same.
mode_is_group_or_world_writable() {
    local mode="$1"
    [[ "$mode" =~ ^[0-7]+$ ]] || return 1
    (( (8#$mode & 8#022) != 0 ))
}

# ── Spinner ──────────────────────────────────────────────────────────
# Only spins on an interactive stdout, so piped/redirected output never gets
# carriage-return noise. The cleanup trap is installed once, at startup, and is
# careful never to fail: a failing EXIT trap would override the script's
# grade-based exit code.
SPINNER_PID=""
SPINNER_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")

_cleanup() {
    if [[ -n "${SPINNER_PID:-}" ]]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    return 0
}
trap _cleanup EXIT
trap '_cleanup; printf "\r\033[K"; exit 130' INT
trap '_cleanup; exit 143' TERM

spin_start() {
    if $QUIET_MODE || [[ ! -t 1 ]]; then return 0; fi
    local msg="$1"
    (
        i=0
        while true; do
            printf "\r  %b%s%b %s  " "$CYAN" "${SPINNER_FRAMES[$((i % ${#SPINNER_FRAMES[@]}))]}" "$NC" "$msg"
            sleep 0.08
            i=$((i + 1))
        done
    ) &
    SPINNER_PID=$!
}

spin_stop() {
    if [[ -n "$SPINNER_PID" ]]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
        if ! $QUIET_MODE && [[ -t 1 ]]; then
            printf "\r\033[K"
        fi
    fi
    return 0
}

check_header() {
    local num="$1" title="$2" cat="$3" pct=0
    CURRENT_CHECK_NUM=$num
    CURRENT_CHECK_TITLE="$title"
    CURRENT_CHECK_CATEGORY="$cat"
    CHECKS_RUN=$((CHECKS_RUN + 1))
    spin_stop
    (( ACTIVE_CHECKS > 0 )) && pct=$(( CHECKS_RUN * 100 / ACTIVE_CHECKS ))
    qprint "${CYAN}[%s/%s %s%%] %s${NC}\n" "$CHECKS_RUN" "$ACTIVE_CHECKS" "$pct" "$title"
}

# run_check <number> <category> <title> <function>
# Applies the --category filter, prints the header, then runs the check body.
run_check() {
    should_run_check "$1" || return 0
    check_header "$1" "$3" "$2"
    "$4"
}

# ── Known-good LaunchAgent whitelist ─────────────────────────────────
KNOWN_AGENTS=(
    "com.google.GoogleUpdater.wake.plist"
    "com.google.keystone.agent.plist"
    "com.google.keystone.xpcservice.plist"
    "com.jetbrains.AppCode.BridgeService.plist"
    "com.lwouis.alt-tab-macos.plist"
    "com.privateinternetaccess.vpn.client.plist"
    "com.valvesoftware.steamclean.plist"
    "homebrew.mxcl.nginx.plist"
    "org.keepassxc.KeePassXC.plist"
    "com.github.facebook.watchman.plist"
    "com.1password.1password-launcher.plist"
    "com.raycast.macos.RaycastLauncher.plist"
    "com.spotify.client.startuphelper.plist"
    "com.dropbox.DropboxMacUpdate.agent.plist"
    "com.microsoft.update.agent.plist"
    "com.adobe.AdobeCreativeCloud.plist"
    "com.docker.helper.plist"
    "com.nordvpn.osx.helper.plist"
    "com.objective-see.lulu.plist"
    "com.malwarebytes.mbam.frontend.agent.plist"
    "com.grammarly.ProjectLlama.plist"
    "org.mozilla.firefoxupdater.plist"
    "com.brave.Browser.UpdaterPrivilegedHelper.plist"
)

is_known_agent() {
    local name="$1"
    for known in "${KNOWN_AGENTS[@]}"; do
        [[ "$name" == "$known" ]] && return 0
    done
    return 1
}

###############################################################################
# CHECKS — Encryption
###############################################################################

check_encryption_filevault() {
    if fdesetup status 2>/dev/null | grep -q "On"; then
        pass "FileVault is ON"
    else
        critical "FileVault is OFF" \
"Your entire disk is readable if the device is lost or stolen.

\`\`\`
Fix: System Settings > Privacy & Security > FileVault > Turn On
\`\`\`"
        show_fix "Enable FileVault" \
            "Open System Settings > Privacy & Security > FileVault > Turn On"
    fi
}

check_encryption_timemachine() {
    local tm_status
    tm_status=$(defaults read /Library/Preferences/com.apple.TimeMachine AutoBackup 2>/dev/null || echo "unknown")
    local tm_dest
    tm_dest=$(tmutil destinationinfo 2>/dev/null || echo "")

    if [[ "$tm_status" == "0" ]]; then
        high "Time Machine backups are disabled" \
"Without backups, data loss from ransomware, hardware failure, or accidental deletion is permanent.

\`\`\`
Fix: System Settings > General > Time Machine > Add Backup Destination
\`\`\`"
        show_fix "Enable Time Machine" \
            "Open System Settings > General > Time Machine > Add Backup Destination"
    elif echo "$tm_dest" | grep -qi "Not Encrypted\|Encryption State.*None"; then
        medium "Time Machine backup destination is not encrypted" \
"An unencrypted backup disk exposes all your data if the backup drive is stolen.

\`\`\`
Fix: System Settings > General > Time Machine > select destination > Encrypt Backup
\`\`\`"
        show_fix "Encrypt Time Machine backup" \
            "Open System Settings > General > Time Machine > select destination > Encrypt Backup"
    elif [[ -n "$tm_dest" ]]; then
        pass "Time Machine is enabled with encrypted backup"
    else
        pass "Time Machine: could not determine backup status"
    fi
}

###############################################################################
# CHECKS — System
###############################################################################

check_system_sip() {
    if csrutil status 2>/dev/null | grep -q "enabled"; then
        pass "SIP is enabled"
    else
        critical "SIP is DISABLED" \
"System Integrity Protection prevents modification of protected system files and code injection into system processes. Without it, rootkits can persist trivially.

\`\`\`
Fix: Boot into Recovery Mode (hold Power on Apple Silicon) > Terminal > csrutil enable
\`\`\`"
        show_fix "Enable SIP (requires Recovery Mode)" \
            "# Boot into Recovery Mode (hold Power on Apple Silicon)" \
            "# Open Terminal from Utilities menu, then run:" \
            "csrutil enable"
    fi
}

check_system_gatekeeper() {
    if spctl --status 2>&1 | grep -q "enabled"; then
        pass "Gatekeeper is enabled"
    else
        critical "Gatekeeper is DISABLED" \
"Unsigned / unnotarised apps can run without any warning.

\`\`\`
Fix: System Settings > Privacy & Security > Security >
     set 'Allow applications from' to App Store or App Store & known developers
     (spctl --master-enable was removed in macOS Sequoia and later)
\`\`\`"
        show_fix "Enable Gatekeeper" \
            "# System Settings > Privacy & Security > Security" \
            "# Set 'Allow applications from' to App Store & known developers" \
            "# On macOS 14 and earlier: sudo spctl --master-enable"
    fi

    SECURE_BOOT=$(system_profiler SPiBridgeDataType 2>/dev/null | awk -F': ' '/Secure Boot/{print $2}')
    if [[ "$SECURE_BOOT" == *"Full"* ]]; then
        pass "Secure Boot: Full Security"
    elif [[ -n "$SECURE_BOOT" ]]; then
        high "Secure Boot: $SECURE_BOOT (not Full Security)" \
"Reduced security allows older or modified kernels to boot.

\`\`\`
Fix: Boot into Recovery > Startup Security Utility > Full Security
\`\`\`"
        show_fix "Set Secure Boot to Full Security" \
            "# Boot into Recovery > Startup Security Utility > Full Security"
    fi
}

check_system_lockdown() {
    LDM_ENABLED=false
    if defaults read /Library/Managed\ Preferences/.GlobalPreferences LDMGlobalEnabled 2>/dev/null | grep -q "1"; then
        LDM_ENABLED=true
    fi
    if defaults read .GlobalPreferences LDMGlobalEnabled 2>/dev/null | grep -q "1"; then
        LDM_ENABLED=true
    fi

    if $LDM_ENABLED; then
        pass "Lockdown Mode is enabled"
    else
        critical "Lockdown Mode is OFF" \
"For a threat model that includes nation-state actors, Lockdown Mode is Apple's primary hardening feature. It restricts JIT, message attachments, inbound connections, config profiles, and more.

\`\`\`
Fix: System Settings > Privacy & Security > Lockdown Mode > Turn On
Note: Some functionality will be limited (web fonts, certain message types, etc.)
\`\`\`"
        show_fix "Enable Lockdown Mode" \
            "Open System Settings > Privacy & Security > Lockdown Mode > Turn On"
    fi
}

check_system_rsr() {
    local rsr
    rsr=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall 2>/dev/null || echo "unknown")
    local rsr_auto
    rsr_auto=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates 2>/dev/null || echo "unknown")

    if [[ "$rsr" == "0" ]] || [[ "$rsr_auto" == "0" ]]; then
        high "Rapid Security Responses may not install automatically" \
"Apple's Rapid Security Responses patch actively exploited vulnerabilities within hours. Disabling them leaves your system exposed.

\`\`\`
Fix: System Settings > General > Software Update > Automatic Updates > enable 'Install Security Responses and system files'
\`\`\`"
        show_fix "Enable Rapid Security Responses" \
            "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true"
    else
        pass "Rapid Security Responses are enabled"
    fi
}

check_system_xprotect() {
    local xp_version=""
    local xp_plist="/Library/Apple/System/Library/CoreServices/XProtect.bundle/Contents/Info.plist"
    if [[ -f "$xp_plist" ]]; then
        xp_version=$(defaults read "$xp_plist" CFBundleShortVersionString 2>/dev/null || echo "")
    fi

    local last_xp_update=""
    last_xp_update=$(system_profiler SPInstallHistoryDataType 2>/dev/null | grep -A2 "XProtect" | awk -F': ' '/Install Date/{print $2; exit}' || echo "")

    if [[ -n "$last_xp_update" ]]; then
        local update_epoch
        update_epoch=$(date -j -f "%Y-%m-%d, %H:%M:%S" "$last_xp_update" "+%s" 2>/dev/null || \
                       date -j -f "%m/%d/%y, %I:%M %p" "$last_xp_update" "+%s" 2>/dev/null || \
                       date -j -f "%d/%m/%y, %I:%M %p" "$last_xp_update" "+%s" 2>/dev/null || \
                       date -j -f "%d/%m/%Y, %H:%M" "$last_xp_update" "+%s" 2>/dev/null || \
                       date -j -f "%Y-%m-%d" "$last_xp_update" "+%s" 2>/dev/null || echo "0")
        local now_epoch
        now_epoch=$(date "+%s")
        if [[ "$update_epoch" != "0" ]]; then
            local days_ago=$(( (now_epoch - update_epoch) / 86400 ))
            if (( days_ago > 90 )); then
                medium "XProtect definitions may be stale (last updated $(days_label "$days_ago") ago, version: ${xp_version:-unknown})" \
"XProtect is macOS's built-in malware detection. Definitions older than 90 days may miss recent threats.

\`\`\`
Fix: System Settings > General > Software Update > check for updates
\`\`\`"
                show_fix "Update XProtect definitions" \
                    "sudo softwareupdate --background-critical"
            else
                pass "XProtect definitions are current ($(days_label "$days_ago") old, version: ${xp_version:-unknown})"
            fi
        else
            pass "XProtect installed (version: ${xp_version:-unknown}, could not determine age)"
        fi
    elif [[ -n "$xp_version" ]]; then
        pass "XProtect installed (version: ${xp_version})"
    else
        medium "Could not verify XProtect definitions" \
"XProtect should be installed on all Macs. Verify manually.

\`\`\`
Fix: System Settings > General > Software Update > check for updates
\`\`\`"
    fi
}

check_system_kext() {
    local extensions
    extensions=$(system_profiler SPExtensionsDataType 2>/dev/null || echo "")
    local third_party=""
    if [[ -n "$extensions" ]]; then
        third_party=$(echo "$extensions" | grep -B1 "Obtained from:.*Not Signed\|Obtained from:.*Identified Developer\|Obtained from:.*Unknown" | grep "Extension Name:" | sed 's/.*Extension Name: /  - /' || true)
    fi

    if [[ -n "$third_party" ]]; then
        medium "Third-party kernel extensions loaded" \
"Kernel extensions run with full system privileges. Third-party kexts increase attack surface:

$third_party

\`\`\`
Fix: Review loaded extensions. macOS is moving to System Extensions — ask vendors for updated drivers.
     System Settings > General > Login Items & Extensions
\`\`\`"
        show_fix "Review kernel extensions" \
            "# System Settings > General > Login Items & Extensions"
    else
        pass "No third-party kernel extensions detected"
    fi
}

check_system_findmymac() {
    local fmm
    fmm=$(defaults read com.apple.FindMyMac FMMEnabled 2>/dev/null || echo "unknown")

    if [[ "$fmm" == "1" ]]; then
        pass "Find My Mac is enabled"
    elif [[ "$fmm" == "0" ]]; then
        medium "Find My Mac is disabled" \
"Find My Mac allows you to locate, lock, or erase a lost/stolen Mac remotely.

\`\`\`
Fix: System Settings > Apple ID > iCloud > Find My Mac > Turn On
\`\`\`"
        show_fix "Enable Find My Mac" \
            "Open System Settings > Apple ID > iCloud > Find My Mac > Turn On"
    else
        pass "Find My Mac: could not determine status (check manually)"
    fi
}

###############################################################################
# CHECKS — Network
###############################################################################

check_network_firewall() {
    FW_BIN="/usr/libexec/ApplicationFirewall/socketfilterfw"
    FW_STATE=$(firewall_state "$("$FW_BIN" --getglobalstate 2>/dev/null || true)")
    case "$FW_STATE" in
        2)
            pass "Firewall is ON — blocking all non-essential incoming connections"
            ;;
        1)
            pass "Firewall is enabled"
            ;;
        0)
            critical "Firewall is DISABLED" \
"Your Mac accepts inbound connections from the network with no filtering.

\`\`\`
Fix: System Settings > Network > Firewall > Turn On
\`\`\`"
            show_fix "Enable Firewall" \
                "sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on"
            ;;
        *)
            # Reporting CRITICAL because a command failed would be a false
            # alarm, and false alarms are how a report stops being read.
            medium "Could not determine firewall state" \
"\`socketfilterfw --getglobalstate\` returned nothing recognisable, so the firewall
was neither confirmed on nor confirmed off. Check it by hand.

\`\`\`
Check: /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate
       System Settings > Network > Firewall
\`\`\`"
            show_fix "Check the firewall state by hand" \
                "/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate"
            ;;
    esac

    if "$FW_BIN" --getstealthmode 2>/dev/null | grep -qi "on\|enabled"; then
        pass "Stealth Mode is ON"
    else
        high "Stealth Mode is OFF" \
"Your Mac responds to network probes (ping, port scans), making it visible on untrusted networks.

\`\`\`
Fix: System Settings > Network > Firewall > Options > Enable Stealth Mode
\`\`\`"
        show_fix "Enable Stealth Mode" \
            "sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on"
    fi
}

check_network_exposure() {
    OPEN_PORTS=$(lsof -iTCP -sTCP:LISTEN -P -n 2>/dev/null | grep -v "127.0.0.1\|::1" | tail -n +2 || true)

    if [[ -n "$OPEN_PORTS" ]]; then
        PORT_LIST=$(echo "$OPEN_PORTS" | awk '{printf "  - %s (PID %s) on %s\n", $1, $2, $(NF-1)}' | sort -u)
        high "Services listening on all network interfaces" \
"The following services are reachable by anyone on your local network:

$PORT_LIST

\`\`\`
Fix: Bind services to 127.0.0.1 (localhost) or stop them if not needed.
     For nginx: change 'listen 8080' to 'listen 127.0.0.1:8080' in nginx.conf
     To stop nginx: brew services stop nginx
\`\`\`"
        qecho "${PORT_LIST//  - /          - }"
        show_fix "Stop exposed services (examples)" \
            "brew services stop nginx" \
            "# Or bind to localhost in service configuration"
    else
        pass "No services exposed on all interfaces"
    fi

    ICMP_BCAST=$(sysctl -n net.inet.icmp.bmcastecho 2>/dev/null || echo "0")
    if [[ "$ICMP_BCAST" == "1" ]]; then
        high "ICMP broadcast echo is enabled" \
"Your machine responds to broadcast pings, making it trivially discoverable on any network.

\`\`\`
Fix: sudo sysctl -w net.inet.icmp.bmcastecho=0
     Persist: echo 'net.inet.icmp.bmcastecho=0' | sudo tee -a /etc/sysctl.conf
\`\`\`"
        show_fix "Disable ICMP broadcast echo" \
            "sudo sysctl -w net.inet.icmp.bmcastecho=0"
    else
        pass "ICMP broadcast echo disabled"
    fi
}

check_network_dns() {
    DNS_SERVERS=$(scutil --dns 2>/dev/null | awk '/nameserver\[0\]/{print $3}' | head -2 | sort -u | tr '\n' ', ' | sed 's/,$//')
    KNOWN_GOOD="1.1.1.1|1.0.0.1|8.8.8.8|8.8.4.4|9.9.9.9|149.112.112.112"
    if echo "$DNS_SERVERS" | grep -qE "$KNOWN_GOOD"; then
        pass "DNS servers: $DNS_SERVERS (known privacy-respecting providers)"
    elif [[ -n "$DNS_SERVERS" ]]; then
        medium "DNS servers: $DNS_SERVERS — not a well-known privacy DNS" \
"Consider using encrypted DNS (1.1.1.1, 9.9.9.9, 8.8.8.8) to prevent DNS snooping.

\`\`\`
Fix: System Settings > Network > Wi-Fi > Details > DNS > add 1.1.1.1 and 1.0.0.1
     Better: use a DNS-over-HTTPS client or configure it in your router
\`\`\`"
        show_fix "Set DNS to privacy-respecting providers" \
            "networksetup -setdnsservers Wi-Fi 1.1.1.1 1.0.0.1"
    else
        medium "Could not determine DNS servers" \
"Verify DNS configuration manually."
    fi

    HOSTS_EXTERNAL=$(grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' /etc/hosts 2>/dev/null | grep -v '127.0.0.1\|255.255.255.255\|0.0.0.0' || true)
    if [[ -n "$HOSTS_EXTERNAL" ]]; then
        HOST_LIST="  ${HOSTS_EXTERNAL//$'\n'/$'\n'  }"
        high "External/production IPs found in /etc/hosts" \
"Your /etc/hosts contains non-local IP addresses. Anyone with access to your machine can see your infrastructure layout:

$HOST_LIST

\`\`\`
Fix: Remove production IPs from /etc/hosts. Use a VPN + private DNS instead.
\`\`\`"
        show_fix "Edit /etc/hosts to remove external IPs" \
            "sudo nano /etc/hosts"
    else
        pass "No external IPs in /etc/hosts"
    fi

    VPN_CONNS=$(scutil --nc list 2>/dev/null | grep -v "^Available\|^$" || true)
    # pgrep rather than `ps | grep`: it matches the full command line the same
    # way, and it does not need the `grep -v grep` that exists only to filter out
    # the pipeline's own process. Nothing here reads the PIDs — the result is
    # tested for emptiness and never acted on.
    VPN_PROCS=$(pgrep -if "openvpn|wireguard|privateinternet|pia|viscosity|mullvad|nordvpn" 2>/dev/null || true)
    if [[ -n "$VPN_PROCS" ]]; then
        pass "VPN process detected as running"
    elif [[ -n "$VPN_CONNS" ]]; then
        medium "VPN configurations exist but no VPN appears to be running" \
"You have VPN software installed but it's not currently active.

\`\`\`
Fix: Enable your VPN, especially on untrusted networks.
     Consider always-on VPN configuration.
\`\`\`"
        show_fix "Enable your VPN" \
            "# Start your VPN client or connect via:" \
            "scutil --nc start 'VPN Connection Name'"
    else
        medium "No VPN detected" \
"No VPN connections or processes found. Use a VPN on untrusted networks.

\`\`\`
Fix: Install and configure a trusted VPN provider.
\`\`\`"
    fi
}

check_network_wifi() {
    ASK_TO_JOIN=$(defaults read /Library/Preferences/SystemConfiguration/com.apple.airport.preferences JoinModeFallback 2>/dev/null || \
        defaults read com.apple.airport.preferences JoinModeFallback 2>/dev/null || echo "unknown")

    if [[ "$ASK_TO_JOIN" == "JoinOpen" ]]; then
        high "Wi-Fi is set to auto-join open networks" \
"Your Mac will automatically connect to any open (unencrypted) Wi-Fi network. This makes evil twin and MITM attacks trivial.

\`\`\`
Fix: System Settings > Wi-Fi > Ask to Join Networks > 'Ask'
     Also: disable 'Auto-Join Hotspot' or set to 'Ask to Join'
\`\`\`"
        show_fix "Disable auto-join for open networks" \
            "# System Settings > Wi-Fi > Ask to Join Networks > 'Ask'" \
            "sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.airport.preferences JoinModeFallback -string 'Prompt'"
    else
        pass "Wi-Fi auto-join for open networks: not enabled (or set to Ask)"
    fi
}

check_network_internet_sharing() {
    local nat_enabled
    nat_enabled=$(defaults read /Library/Preferences/SystemConfiguration/com.apple.nat NAT 2>/dev/null | grep -c "Enabled = 1" || true)

    if [[ "$nat_enabled" -gt 0 ]]; then
        high "Internet Sharing is enabled" \
"Your Mac is acting as a network router, sharing its internet connection. This creates an unmanaged access point.

\`\`\`
Fix: System Settings > General > Sharing > Internet Sharing > Turn Off
\`\`\`"
        show_fix "Disable Internet Sharing" \
            "Open System Settings > General > Sharing > Internet Sharing > Turn Off"
    else
        pass "Internet Sharing is disabled"
    fi
}

check_network_wake() {
    local womp
    womp=$(pmset -g 2>/dev/null | awk '/womp/{print $2}' || echo "unknown")
    if [[ "$womp" == "unknown" ]] || [[ -z "$womp" ]]; then
        womp=$(systemsetup -getwakeonnetworkaccess 2>/dev/null | awk -F': ' '{print $2}' || echo "unknown")
    fi

    if [[ "$womp" == "1" ]] || echo "$womp" | grep -qi "on"; then
        medium "Wake on Network Access is enabled" \
"Your Mac can be woken remotely via network traffic, increasing the window for remote attacks when you expect it to be asleep.

\`\`\`
Fix: System Settings > Battery > Options > Wake for network access > Never
     Or: sudo pmset -a womp 0
\`\`\`"
        show_fix "Disable Wake on Network Access" \
            "sudo pmset -a womp 0"
    else
        pass "Wake on Network Access is disabled"
    fi
}

###############################################################################
# CHECKS — Sharing
###############################################################################

check_sharing_services() {
    # AirDrop
    AIRDROP_MODE=$(defaults read com.apple.sharingd DiscoverableMode 2>/dev/null || echo "unknown")
    if [[ "$AIRDROP_MODE" == "Everyone" ]]; then
        critical "AirDrop is set to 'Everyone'" \
"Your Mac is discoverable by any nearby device. Proximity-based attacks and surveillance have used AirDrop as a vector.

\`\`\`
Fix: System Settings > General > AirDrop & Handoff > AirDrop > 'Contacts Only' or 'No One'
\`\`\`"
        show_fix "Set AirDrop to Contacts Only" \
            "defaults write com.apple.sharingd DiscoverableMode -string 'Contacts Only'"
    elif [[ "$AIRDROP_MODE" == "Off" ]]; then
        pass "AirDrop is OFF"
    else
        pass "AirDrop is set to '${AIRDROP_MODE}'"
    fi

    # Screen Sharing
    if daemon_loaded com.apple.screensharing; then
        high "Screen Sharing is enabled" \
"Allows remote VNC-like access to your desktop.

\`\`\`
Fix: System Settings > General > Sharing > Disable 'Screen Sharing'
\`\`\`"
        show_fix "Disable Screen Sharing" \
            "sudo launchctl unload -w /System/Library/LaunchDaemons/com.apple.screensharing.plist"
    else
        pass "Screen Sharing is disabled"
    fi

    # File Sharing (SMB)
    if daemon_loaded com.apple.smbd; then
        high "File Sharing (SMB) is enabled" \
"Exposes file shares on the network.

\`\`\`
Fix: System Settings > General > Sharing > Disable 'File Sharing'
\`\`\`"
        show_fix "Disable File Sharing" \
            "sudo launchctl unload -w /System/Library/LaunchDaemons/com.apple.smbd.plist"
    else
        pass "File Sharing (SMB) is disabled"
    fi

    # Remote Management (ARD)
    # daemon_loaded alone is insufficient — the agent stays registered in launchd
    # even after kickstart -deactivate. Check if it's actually running (has a PID)
    # or if the preference plist indicates it's active.
    if launchctl list com.apple.RemoteDesktop.agent 2>/dev/null | grep -q '"PID"'; then
        critical "Remote Management (ARD) is loaded" \
"Apple Remote Desktop agent is running. This allows remote control of your machine if exploited or misconfigured.

\`\`\`
Fix: System Settings > General > Sharing > Disable 'Remote Management'
     Or via terminal: sudo /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart -deactivate -configure -access -off
\`\`\`"
        show_fix "Disable Remote Management (ARD)" \
            "sudo /System/Library/CoreServices/RemoteManagement/ARDAgent.app/Contents/Resources/kickstart -deactivate -configure -access -off"
    else
        pass "Remote Management (ARD) is disabled"
    fi

    # SSH / Remote Login
    SSH_STATUS=$(systemsetup -getremotelogin 2>/dev/null || echo "")
    if echo "$SSH_STATUS" | grep -qi "on"; then
        high "Remote Login (SSH) is enabled" \
"SSH access is available. Ensure it's intentional and key-only auth is configured.

\`\`\`
Fix: System Settings > General > Sharing > Disable 'Remote Login'
     Or harden: PasswordAuthentication no in /etc/ssh/sshd_config
\`\`\`"
        show_fix "Disable Remote Login" \
            "sudo systemsetup -setremotelogin off"
    else
        pass "Remote Login (SSH) is disabled"
    fi
}

check_sharing_remote_apple_events() {
    local rae
    rae=$(systemsetup -getremoteappleevents 2>/dev/null || echo "")
    if [[ -z "$rae" ]]; then
        if launchctl list com.apple.AEServer &>/dev/null; then
            rae="On"
        else
            rae="Off"
        fi
    fi

    if echo "$rae" | grep -qi "on"; then
        high "Remote Apple Events are enabled" \
"Remote Apple Events allow other computers to send AppleScript commands to this Mac. This is a remote code execution vector.

\`\`\`
Fix: System Settings > General > Sharing > Remote Apple Events > Turn Off
\`\`\`"
        show_fix "Disable Remote Apple Events" \
            "sudo systemsetup -setremoteappleevents off"
    else
        pass "Remote Apple Events are disabled"
    fi
}

check_sharing_content_caching() {
    local cc
    cc=$(defaults read /Library/Preferences/com.apple.AssetCache.plist Activated 2>/dev/null || echo "0")

    if [[ "$cc" == "1" ]]; then
        medium "Content Caching is enabled" \
"Content Caching shares downloaded Apple content with other devices on your network. While useful in managed environments, it increases network exposure.

\`\`\`
Fix: System Settings > General > Sharing > Content Caching > Turn Off
\`\`\`"
        show_fix "Disable Content Caching" \
            "Open System Settings > General > Sharing > Content Caching > Turn Off"
    else
        pass "Content Caching is disabled"
    fi
}

check_sharing_printer() {
    local ps
    ps=$(defaults read /Library/Preferences/org.cups.cupsd SharePrinters 2>/dev/null || echo "0")

    if [[ "$ps" == "1" ]]; then
        medium "Printer Sharing is enabled" \
"Shared printers are accessible to other devices on your network, which can be an information disclosure vector.

\`\`\`
Fix: System Settings > General > Sharing > Printer Sharing > Turn Off
\`\`\`"
        show_fix "Disable Printer Sharing" \
            "Open System Settings > General > Sharing > Printer Sharing > Turn Off"
    else
        pass "Printer Sharing is disabled"
    fi
}

check_sharing_media() {
    local ms
    ms=$(defaults read com.apple.amp.mediasharingd home-sharing-enabled 2>/dev/null || echo "0")
    local ms2
    ms2=$(defaults read com.apple.amp.mediasharingd public-sharing-enabled 2>/dev/null || echo "0")

    if [[ "$ms" == "1" ]] || [[ "$ms2" == "1" ]]; then
        medium "Media Sharing is enabled" \
"Home Sharing or media library sharing exposes your media content on the local network.

\`\`\`
Fix: System Settings > General > Sharing > Media Sharing > Turn Off all toggles
\`\`\`"
        show_fix "Disable Media Sharing" \
            "Open System Settings > General > Sharing > Media Sharing > Turn Off"
    else
        pass "Media Sharing is disabled"
    fi
}

check_sharing_handoff() {
    local handoff_allowed="unknown"
    local byhost_dir="$HOME/Library/Preferences/ByHost"
    if [[ -d "$byhost_dir" ]]; then
        handoff_allowed=$(defaults read "$byhost_dir/com.apple.coreservices.useractivityd" ActivityAdvertisingAllowed 2>/dev/null || echo "unknown")
    fi

    if [[ "$handoff_allowed" == "0" ]]; then
        pass "Handoff is disabled"
    elif [[ "$handoff_allowed" == "1" ]]; then
        medium "Handoff is enabled" \
"Handoff shares activity data between your Apple devices via Bluetooth and Wi-Fi. On shared/public networks this can leak information about your activity.

\`\`\`
Fix: System Settings > General > AirDrop & Handoff > Allow Handoff between this Mac and your iCloud devices > Off
\`\`\`"
        show_fix "Disable Handoff" \
            "Open System Settings > General > AirDrop & Handoff > Handoff > Off"
    else
        pass "Handoff: could not determine status"
    fi
}

###############################################################################
# CHECKS — Auth
###############################################################################

check_auth_users() {
    # Auto-login
    if defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser &>/dev/null; then
        critical "Auto-login is ENABLED" \
"Anyone who opens the laptop lid gets full access — no password required.

\`\`\`
Fix: System Settings > Users & Groups > Disable automatic login
\`\`\`"
        show_fix "Disable auto-login" \
            "sudo defaults delete /Library/Preferences/com.apple.loginwindow autoLoginUser"
    else
        pass "Auto-login is disabled"
    fi

    # Admin users
    ADMIN_USERS=$(dscl . -read /Groups/admin GroupMembership 2>/dev/null | sed 's/GroupMembership: //' || echo "")
    ADMIN_COUNT=$(echo "$ADMIN_USERS" | wc -w | tr -d ' ')
    if (( ADMIN_COUNT > 2 )); then
        medium "Multiple admin accounts: $ADMIN_USERS" \
"More admin accounts = larger attack surface. Use a standard account for daily use.

\`\`\`
Fix: System Settings > Users & Groups > demote unnecessary admins to Standard
\`\`\`"
        show_fix "Demote unnecessary admin accounts" \
            "# System Settings > Users & Groups > select user > change to Standard"
    else
        pass "Admin users: $ADMIN_USERS"
    fi

    # Screen lock / password after sleep
    SCREENLOCK_STATUS=$(sysadminctl -screenLock status 2>&1 || true)
    if echo "$SCREENLOCK_STATUS" | grep -qi "immediate"; then
        pass "Screen lock requires password immediately"
    elif echo "$SCREENLOCK_STATUS" | grep -qi "screenLock delay"; then
        DELAY_INFO="${SCREENLOCK_STATUS##*screenLock delay is }"
        medium "Screen lock delay is: ${DELAY_INFO}" \
"An attacker with brief physical access could unlock the machine within the grace window.

\`\`\`
Fix: System Settings > Lock Screen > Require password after screen saver begins
     or display is turned off: 'Immediately'
\`\`\`"
        show_fix "Set screen lock to immediate" \
            "sysadminctl -screenLock immediate -password -"
    else
        ASK_PWD=$(defaults read com.apple.screensaver askForPassword 2>/dev/null || echo "unknown")
        ASK_DELAY=$(defaults read com.apple.screensaver askForPasswordDelay 2>/dev/null || echo "unknown")
        if [[ "$ASK_PWD" == "1" && "$ASK_DELAY" == "0" ]]; then
            pass "Screen lock requires password immediately"
        elif [[ "$ASK_PWD" == "1" ]]; then
            medium "Screen lock has a grace period of ${ASK_DELAY}s before requiring password" \
"An attacker with brief physical access could unlock the machine within the grace window.

\`\`\`
Fix: System Settings > Lock Screen > Require password: 'Immediately'
\`\`\`"
            show_fix "Set screen lock to immediate" \
                "defaults write com.apple.screensaver askForPasswordDelay -int 0"
        else
            medium "Could not confirm screen lock requires password immediately" \
"Verify manually that password is required immediately on sleep/screensaver.

\`\`\`
Fix: System Settings > Lock Screen > Require password: 'Immediately'
\`\`\`"
        fi
    fi

    # Keychain lock timeout
    KC_INFO=$(security show-keychain-info ~/Library/Keychains/login.keychain-db 2>&1 || true)
    if echo "$KC_INFO" | grep -q "no-timeout"; then
        high "Login keychain has no lock timeout" \
"Once unlocked at login, your keychain stays unlocked forever. Malware with code execution can extract all stored secrets without re-prompting.

\`\`\`
Fix: security set-keychain-settings -t 3600 -l ~/Library/Keychains/login.keychain-db
     (locks after 1 hour of inactivity and on sleep)
\`\`\`"
        show_fix "Set keychain to lock after 1 hour and on sleep" \
            "security set-keychain-settings -t 3600 -l ~/Library/Keychains/login.keychain-db"
    else
        pass "Login keychain has a lock timeout configured"
    fi
}

check_auth_ssh() {
    AUTH_KEYS="$HOME/.ssh/authorized_keys"
    # Count real key lines only: `wc -l` misses a final line with no trailing
    # newline and counts blanks and comments as keys.
    KEY_COUNT=0
    if [[ -f "$AUTH_KEYS" ]] && [[ -s "$AUTH_KEYS" ]]; then
        KEY_COUNT=$(grep -cvE '^[[:space:]]*(#|$)' "$AUTH_KEYS" 2>/dev/null || true)
        [[ "$KEY_COUNT" =~ ^[0-9]+$ ]] || KEY_COUNT=0
    fi
    if (( KEY_COUNT > 0 )); then
        high "$KEY_COUNT key(s) in authorized_keys — verify they are all yours" \
"Any key listed here grants passwordless SSH access to this machine.

\`\`\`
Fix: Review ~/.ssh/authorized_keys and remove any unrecognised keys
\`\`\`"
        show_fix "Review authorized_keys" \
            "cat ~/.ssh/authorized_keys" \
            "# Remove unrecognised keys with a text editor"
    else
        pass "No authorized_keys file (or empty)"
    fi

    SSH_DIR_PERMS=$(stat -f "%Lp" ~/.ssh 2>/dev/null || echo "")
    if [[ -n "$SSH_DIR_PERMS" && "$SSH_DIR_PERMS" != "700" ]]; then
        # shellcheck disable=SC2088  # the tilde is display text, not a path
        medium "~/.ssh directory permissions are $SSH_DIR_PERMS (should be 700)" \
"\`\`\`
Fix: chmod 700 ~/.ssh
\`\`\`"
        show_fix "Fix ~/.ssh permissions" \
            "chmod 700 ~/.ssh"
    elif [[ -n "$SSH_DIR_PERMS" ]]; then
        # shellcheck disable=SC2088  # the tilde is display text, not a path
        pass "~/.ssh permissions are 700"
    fi
}

check_auth_screensaver() {
    local idle_time
    idle_time=$(defaults read com.apple.screensaver idleTime 2>/dev/null || echo "0")

    if [[ "$idle_time" == "0" ]] || [[ -z "$idle_time" ]]; then
        medium "Screen saver is not configured to activate automatically" \
"Without an automatic screen saver, your screen stays unlocked indefinitely when you walk away.

\`\`\`
Fix: System Settings > Lock Screen > 'Start Screen Saver when inactive' > set to 5 minutes or less
\`\`\`"
        show_fix "Set screen saver timeout" \
            "defaults write com.apple.screensaver idleTime -int 300"
    elif (( idle_time > 600 )); then
        medium "Screen saver timeout is ${idle_time}s (more than 10 minutes)" \
"A long timeout leaves your machine accessible if you step away.

\`\`\`
Fix: System Settings > Lock Screen > 'Start Screen Saver when inactive' > 5 minutes or less
\`\`\`"
        show_fix "Reduce screen saver timeout to 5 minutes" \
            "defaults write com.apple.screensaver idleTime -int 300"
    else
        pass "Screen saver activates after ${idle_time}s"
    fi
}

check_auth_login_window() {
    local issues=""

    local show_full
    show_full=$(defaults read /Library/Preferences/com.apple.loginwindow SHOWFULLNAME 2>/dev/null || echo "unknown")
    if [[ "$show_full" == "0" ]]; then
        issues="${issues}  - Login window shows user list (reveals account names)\n"
    fi

    local hints
    hints=$(defaults read /Library/Preferences/com.apple.loginwindow RetriesUntilHint 2>/dev/null || echo "unknown")
    if [[ "$hints" =~ ^[0-9]+$ ]] && (( hints > 0 )); then
        issues="${issues}  - Password hints shown after ${hints} failed attempt(s)\n"
    fi

    if [[ -n "$issues" ]]; then
        medium "Login window configuration could be hardened" \
"$(echo -e "$issues")
\`\`\`
Fix: defaults write /Library/Preferences/com.apple.loginwindow SHOWFULLNAME -bool true
     defaults write /Library/Preferences/com.apple.loginwindow RetriesUntilHint -int 0
\`\`\`"
        show_fix "Harden login window" \
            "sudo defaults write /Library/Preferences/com.apple.loginwindow SHOWFULLNAME -bool true" \
            "sudo defaults write /Library/Preferences/com.apple.loginwindow RetriesUntilHint -int 0"
    else
        pass "Login window configuration is hardened"
    fi
}

check_auth_touchid() {
    TOUCHID_HW=$(biometric -s 2>/dev/null || system_profiler SPiBridgeDataType 2>/dev/null | grep -i "fingerprint" || echo "")
    TOUCHID_ENROLLED=$(bioutil -c -s 2>/dev/null || echo "")

    if echo "$TOUCHID_ENROLLED" | grep -qi "fingerprints.*:.*[1-9]"; then
        pass "Touch ID is enrolled with fingerprint(s)"
    elif echo "$TOUCHID_ENROLLED" | grep -qi "fingerprints.*:.*0\|no fingerprints\|not enrolled"; then
        medium "Touch ID hardware present but no fingerprints enrolled" \
"Touch ID adds a strong physical access control layer. Without it, only a password protects your session.

\`\`\`
Fix: System Settings > Touch ID & Password > Add a Fingerprint
\`\`\`"
        show_fix "Enroll a fingerprint in Touch ID" \
            "Open System Settings > Touch ID & Password > Add a Fingerprint"
    elif [[ -n "$TOUCHID_HW" ]]; then
        BIOUTIL_OUTPUT=$(bioutil -rs 2>/dev/null || echo "")
        if echo "$BIOUTIL_OUTPUT" | grep -qi "count.*[1-9]\|user.*template"; then
            pass "Touch ID is enrolled"
        else
            medium "Touch ID may not be enrolled — verify manually" \
"Could not confirm fingerprint enrollment. Touch ID adds a strong physical access control layer.

\`\`\`
Fix: System Settings > Touch ID & Password > Add a Fingerprint
\`\`\`"
            show_fix "Enroll a fingerprint in Touch ID" \
                "Open System Settings > Touch ID & Password > Add a Fingerprint"
        fi
    else
        pass "Touch ID: not available on this hardware (skipped)"
    fi
}

check_auth_usb() {
    ACCESSORY_SECURITY=$(defaults read /Library/Preferences/com.apple.security USBRestrictedMode 2>/dev/null || echo "unknown")

    if [[ "$ACCESSORY_SECURITY" == "0" ]]; then
        high "USB Restricted Mode is DISABLED" \
"USB accessories can connect even when your Mac is locked. This allows USB-based attacks (BadUSB, rubber ducky) without requiring unlock.

\`\`\`
Fix: System Settings > Privacy & Security > Allow accessories to connect > 'Ask for New Accessories'
\`\`\`"
        show_fix "Enable USB Restricted Mode" \
            "Open System Settings > Privacy & Security > Allow accessories to connect > 'Ask for New Accessories'"
    else
        pass "USB Restricted Mode: accessories require approval or device is unlocked"
    fi
}

###############################################################################
# CHECKS — Privacy
###############################################################################

check_privacy_location() {
    # NOTE: locationd's plist is root-owned. We deliberately do NOT try sudo —
    # the audit must never escalate privileges — and fall back to whether the
    # locationd daemon is loaded.
    LOCATION_ENABLED=$(defaults read /var/db/locationd/Library/Preferences/ByHost/com.apple.locationd LocationServicesEnabled 2>/dev/null || echo "unknown")
    if [[ "$LOCATION_ENABLED" == "unknown" ]]; then
        if launchctl list com.apple.locationd &>/dev/null; then
            LOCATION_ENABLED="1"
        else
            LOCATION_ENABLED="0"
        fi
    fi

    if [[ "$LOCATION_ENABLED" == "1" ]]; then
        medium "Location Services are enabled globally" \
"Location Services allow apps to access your physical location. Review which apps have access.

\`\`\`
Fix: System Settings > Privacy & Security > Location Services > review app access
     Disable entirely if not needed: toggle off Location Services
\`\`\`"
        show_fix "Review Location Services settings" \
            "Open System Settings > Privacy & Security > Location Services"
    elif [[ "$LOCATION_ENABLED" == "0" ]]; then
        pass "Location Services are disabled"
    else
        pass "Location Services: could not determine status (check manually)"
    fi
}

check_privacy_analytics() {
    CRASH_PLIST="/Library/Application Support/CrashReporter/DiagnosticMessagesHistory.plist"
    ANALYTICS_ISSUES=""
    # Named separately so the one-line summary can say *which* toggle is on.
    # "Analytics & telemetry sharing is enabled" reads as though all three are,
    # and sends you to the wrong settings pane looking for the other two.
    ANALYTICS_NAMES=""

    SHARE_ANALYTICS=$(defaults read "$CRASH_PLIST" AutoSubmit 2>/dev/null || echo "unknown")
    if [[ "$SHARE_ANALYTICS" == "1" ]]; then
        ANALYTICS_ISSUES="${ANALYTICS_ISSUES}  - Share Mac Analytics is ON — crash logs, hangs and usage statistics go to Apple\n"
        ANALYTICS_NAMES="${ANALYTICS_NAMES}Share Mac Analytics, "
    fi

    SHARE_APP_DEV=$(defaults read "$CRASH_PLIST" ThirdPartyDataSubmit 2>/dev/null || echo "unknown")
    if [[ "$SHARE_APP_DEV" == "1" ]]; then
        ANALYTICS_ISSUES="${ANALYTICS_ISSUES}  - Share with App Developers is ON — the same crash data is forwarded to third-party developers\n"
        ANALYTICS_NAMES="${ANALYTICS_NAMES}Share with App Developers, "
    fi

    # "Improve Assistive Voice Features" — System Settings > Accessibility, and
    # mirrored in Analytics & Improvements. Key identified by flipping the
    # toggle and diffing the preference domains: com.apple.Accessibility gains
    # AXSAudioDonationSiriImprovementEnabled = 1. Only 1 counts as ON; the
    # off-state value was never observed and guessing it is precisely how the
    # Siri check below ended up backwards.
    VOICE_DONATION=$(defaults read com.apple.Accessibility AXSAudioDonationSiriImprovementEnabled 2>/dev/null || echo "")
    if [[ "$VOICE_DONATION" == "1" ]]; then
        ANALYTICS_ISSUES="${ANALYTICS_ISSUES}  - Improve Assistive Voice Features is ON — audio and transcripts of your Voice Control and Vocal Shortcuts interactions go to Apple\n"
        ANALYTICS_NAMES="${ANALYTICS_NAMES}Improve Assistive Voice Features, "
    fi

    SIRI_DATA=$(defaults read com.apple.assistant.support "Siri Data Sharing Opt-In Status" 2>/dev/null || echo "")
    if [[ "$(siri_sharing_state "$SIRI_DATA")" == "on" ]]; then
        ANALYTICS_ISSUES="${ANALYTICS_ISSUES}  - Improve Siri & Dictation is ON — audio recordings of your Siri and dictation requests may be stored and reviewed\n"
        ANALYTICS_NAMES="${ANALYTICS_NAMES}Improve Siri & Dictation, "
    fi

    if [[ -n "$ANALYTICS_ISSUES" ]]; then
        ANALYTICS_NAMES="${ANALYTICS_NAMES%, }"
        medium "Telemetry sharing is ON: $ANALYTICS_NAMES" \
"Active telemetry, and what each one actually sends:

$(printf '%b' "$ANALYTICS_ISSUES")
The toggles that are not listed above are already off — only the ones named
here are sending anything.

**Turn them off in the GUI (one pane, all three):**

System Settings > Privacy & Security > Analytics & Improvements

  - \"Share Mac Analytics\"              -> off
  - \"Improve Siri & Dictation\"         -> off
  - \"Improve Assistive Voice Features\" -> off
  - \"Share with app developers\"        -> off  (greyed out until the first is off)
  - \"Share iCloud Analytics\"           -> off

\"Share iCloud Analytics\" is the one toggle this check cannot read: it is stored
with your Apple Account rather than in a local preference file, so verify that
one by eye in the pane.

**Or from the terminal:**

\`\`\`
sudo defaults write '$CRASH_PLIST' AutoSubmit -bool false
sudo defaults write '$CRASH_PLIST' ThirdPartyDataSubmit -bool false
defaults write com.apple.assistant.support 'Siri Data Sharing Opt-In Status' -int 2
defaults write com.apple.Accessibility AXSAudioDonationSiriImprovementEnabled -bool false
\`\`\`

(\`-int 2\` is the explicit opt-out. \`0\` means \"never asked\" and makes macOS
prompt again.)

The first two write a file under /Library and need \`sudo\`; the Siri one is
per-user and does not. Log out and back in afterwards — the settings pane caches
these values and will keep showing the old state until you do.

**Turning off \"Improve Siri & Dictation\" does not delete what Apple already
has.** To erase past recordings: System Settings > Siri & Spotlight > Siri
History > Delete Siri & Dictation History."
        # Breakdown first, then the fix block — otherwise --show-fix wedges four
        # commands between the summary and the list of what they are fixing.
        qprint "%b" "${ANALYTICS_ISSUES//  - /          - }"
        show_fix "Disable analytics sharing" \
            "sudo defaults write '$CRASH_PLIST' AutoSubmit -bool false" \
            "sudo defaults write '$CRASH_PLIST' ThirdPartyDataSubmit -bool false" \
            "defaults write com.apple.assistant.support 'Siri Data Sharing Opt-In Status' -int 2" \
            "defaults write com.apple.Accessibility AXSAudioDonationSiriImprovementEnabled -bool false"
    else
        pass "Analytics & telemetry sharing appears disabled"
    fi
}

check_privacy_bluetooth() {
    BT_INFO=$(system_profiler SPBluetoothDataType 2>/dev/null || true)
    BT_POWER="unknown"
    if echo "$BT_INFO" | grep -qi "State:.*On\|Power:.*On\|Bluetooth.*On"; then
        BT_POWER="1"
    elif echo "$BT_INFO" | grep -qi "State:.*Off\|Power:.*Off\|Bluetooth.*Off"; then
        BT_POWER="0"
    else
        BT_POWER=$(defaults read /Library/Preferences/com.apple.Bluetooth ControllerPowerState 2>/dev/null || echo "unknown")
    fi

    if [[ "$BT_POWER" == "0" ]]; then
        pass "Bluetooth is OFF"
    elif [[ "$BT_POWER" == "1" ]]; then
        BT_DISC_STATUS=$(echo "$BT_INFO" | awk -F': ' '/Discoverable/{print $2; exit}' || echo "unknown")
        if [[ "$BT_DISC_STATUS" == *"Yes"* ]]; then
            high "Bluetooth is ON and discoverable" \
"Your Mac is visible to all nearby Bluetooth devices, which can be used for tracking and proximity attacks.

\`\`\`
Fix: System Settings > Bluetooth > Turn off when not in use
     Or close the Bluetooth settings pane to stop discoverability
\`\`\`"
            show_fix "Turn off Bluetooth (if not needed)" \
                "sudo defaults write /Library/Preferences/com.apple.Bluetooth ControllerPowerState -int 0" \
                "sudo killall -HUP bluetoothd"
        else
            pass "Bluetooth is ON but not discoverable"
        fi
    else
        if pgrep -q bluetoothd 2>/dev/null; then
            pass "Bluetooth daemon is running (state unclear — verify in System Settings)"
        else
            pass "Bluetooth appears OFF (daemon not running)"
        fi
    fi
}

check_privacy_siri() {
    local siri_voice
    siri_voice=$(defaults read com.apple.Siri VoiceTriggerUserEnabled 2>/dev/null || echo "unknown")
    if [[ "$siri_voice" == "1" ]]; then
        medium "'Hey Siri' voice trigger is enabled" \
"Always-on microphone listening is a privacy concern.

\`\`\`
Fix: System Settings > Siri & Spotlight > Disable 'Listen for \"Hey Siri\"'
\`\`\`"
        show_fix "Disable Hey Siri voice trigger" \
            "defaults write com.apple.Siri VoiceTriggerUserEnabled -bool false"
    elif [[ "$siri_voice" == "0" ]]; then
        pass "'Hey Siri' voice trigger is disabled"
    else
        pass "Siri voice trigger: could not determine status"
    fi
}

###############################################################################
# CHECKS — Software
###############################################################################

check_software_updates() {
    AUTO_CHECK=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled 2>/dev/null || echo "missing")
    AUTO_DL=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload 2>/dev/null || echo "0")
    CRITICAL_INSTALL=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall 2>/dev/null || echo "0")
    AUTO_MACOS=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates 2>/dev/null || echo "0")

    UPDATES_OK=true
    if [[ "$AUTO_CHECK" == "0" ]]; then UPDATES_OK=false; fi
    if [[ "$AUTO_DL" == "0" ]]; then UPDATES_OK=false; fi
    if [[ "$CRITICAL_INSTALL" == "0" ]]; then UPDATES_OK=false; fi
    if [[ "$AUTO_MACOS" == "0" ]]; then UPDATES_OK=false; fi

    if $UPDATES_OK; then
        pass "Automatic security updates enabled"
    else
        high "Automatic security updates not fully enabled" \
"Critical patches may not be installed automatically, leaving known vulnerabilities open.

\`\`\`
Fix: System Settings > General > Software Update > Automatic Updates > enable all toggles
\`\`\`"
        show_fix "Enable automatic updates" \
            "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled -bool true" \
            "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticDownload -bool true" \
            "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate CriticalUpdateInstall -bool true" \
            "sudo defaults write /Library/Preferences/com.apple.SoftwareUpdate AutomaticallyInstallMacOSUpdates -bool true"
    fi

    # ── Pending updates ──
    # `softwareupdate -l` contacts Apple's update servers, so it only runs with
    # an explicit --online. Offline we read the values macOS itself cached at
    # its last check, which is enough to spot a machine that is behind.
    if $ONLINE_MODE; then
        PENDING=$(softwareupdate -l 2>&1 || true)
        if echo "$PENDING" | grep -q "No new software available"; then
            pass "macOS is up to date (checked with Apple)"
        else
            high "Pending software updates available" \
"$PENDING

\`\`\`
Fix: softwareupdate --install --all
\`\`\`"
            show_fix "Install pending updates" \
                "sudo softwareupdate --install --all"
        fi
    else
        # RecommendedUpdates is the authoritative cached list. The scalar
        # LastRecommendedUpdatesAvailable is only a fallback: it is known to go
        # stale and keep reporting 1 after the update has been installed.
        CACHED_PENDING="unknown"
        REC_UPDATES=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate RecommendedUpdates 2>/dev/null || echo "")
        if [[ -n "$REC_UPDATES" ]]; then
            CACHED_PENDING=$(printf '%s\n' "$REC_UPDATES" | grep -c 'Identifier' || true)
        else
            CACHED_PENDING=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate LastRecommendedUpdatesAvailable 2>/dev/null || echo "unknown")
        fi
        LAST_CHECK=$(defaults read /Library/Preferences/com.apple.SoftwareUpdate LastSuccessfulDate 2>/dev/null || echo "")
        CHECK_AGE_DAYS=""
        if [[ -n "$LAST_CHECK" ]]; then
            LAST_CHECK_EPOCH=$(date -j -f "%Y-%m-%d %H:%M:%S %z" "$LAST_CHECK" +%s 2>/dev/null || echo "")
            if [[ -n "$LAST_CHECK_EPOCH" ]]; then
                CHECK_AGE_DAYS=$(( ( $(date +%s) - LAST_CHECK_EPOCH ) / 86400 ))
            fi
        fi

        if [[ "$CACHED_PENDING" =~ ^[0-9]+$ ]] && (( CACHED_PENDING > 0 )); then
            high "${CACHED_PENDING} pending update(s) at macOS's last check" \
"macOS recorded ${CACHED_PENDING} recommended update(s) as available the last time it checked${CHECK_AGE_DAYS:+ ($(days_label "$CHECK_AGE_DAYS") ago)}.

\`\`\`
Fix: softwareupdate --install --all
     Re-run with --online to query Apple for the current list
\`\`\`"
            show_fix "Install pending updates" \
                "sudo softwareupdate --install --all"
        elif [[ -n "$CHECK_AGE_DAYS" ]] && (( CHECK_AGE_DAYS > 30 )); then
            medium "macOS has not checked for updates in $(days_label "$CHECK_AGE_DAYS")" \
"A stale update check means a pending security patch can go unnoticed.

\`\`\`
Fix: System Settings > General > Software Update
     Or: softwareupdate -l
\`\`\`"
            show_fix "Check for updates" \
                "softwareupdate -l"
        elif [[ "$CACHED_PENDING" == "unknown" ]]; then
            pass "Pending updates: no cached result (run with --online to query Apple)"
        else
            pass "No pending updates at macOS's last check${CHECK_AGE_DAYS:+ ($(days_label "$CHECK_AGE_DAYS") ago)}"
        fi
    fi
}

check_software_review() {
    # ── Offensive / dual-use tools ──
    OFFENSIVE_TOOLS=""
    for tool in bettercap mitmproxy nmap wireshark sherlock hydra john hashcat metasploit msfconsole aircrack-ng; do
        if cmd_exists "$tool"; then
            OFFENSIVE_TOOLS="${OFFENSIVE_TOOLS}  - ${tool}\n"
        fi
    done
    for app in Wireshark Burp\ Suite; do
        if [[ -d "/Applications/${app}.app" ]]; then
            OFFENSIVE_TOOLS="${OFFENSIVE_TOOLS}  - ${app} (GUI)\n"
        fi
    done

    if [[ -n "$OFFENSIVE_TOOLS" ]]; then
        medium "Offensive / dual-use security tools installed" \
"While legitimate for security work, these increase attack surface and could be weaponised if your machine is compromised:

$(echo -e "$OFFENSIVE_TOOLS")
\`\`\`
Fix: Uninstall any you're not actively using. Keep them in a VM if needed for security work.
\`\`\`"
        qecho -e "${OFFENSIVE_TOOLS//  - /          - }"
        show_fix "Uninstall unused offensive tools (example)" \
            "brew uninstall nmap" \
            "# Or remove from /Applications"
    else
        pass "No offensive tools detected"
    fi

    # ── Third-party LaunchDaemons ──
    # A glob rather than `ls | grep`: a daemon plist with a newline in its
    # name would otherwise be split into two bogus entries.
    THIRD_PARTY_DAEMONS=""
    for plist in /Library/LaunchDaemons/*; do
        [[ -e "$plist" ]] || continue
        plist_name="${plist##*/}"
        case "$plist_name" in com.apple*) continue ;; esac
        THIRD_PARTY_DAEMONS="${THIRD_PARTY_DAEMONS}${plist_name}\n"
    done
    THIRD_PARTY_DAEMONS=$(printf '%b' "$THIRD_PARTY_DAEMONS")
    if [[ -n "$THIRD_PARTY_DAEMONS" ]]; then
        DAEMON_LIST="  - ${THIRD_PARTY_DAEMONS//$'\n'/$'\n'  - }"

        if echo "$THIRD_PARTY_DAEMONS" | grep -qi "teamviewer"; then
            critical "TeamViewer LaunchDaemons are installed" \
"TeamViewer has persistent system-level daemons running as root. TeamViewer has been repeatedly compromised (2016, 2019, 2024 breaches) and is a known target for intelligence services.

Third-party LaunchDaemons found:
$DAEMON_LIST

**How to fully uninstall TeamViewer:**

1. Quit TeamViewer if running
2. Open Finder > Applications > right-click TeamViewer > Move to Trash
3. Remove leftover system files:
\`\`\`
sudo launchctl unload /Library/LaunchDaemons/com.teamviewer.Helper.plist
sudo launchctl unload /Library/LaunchDaemons/com.teamviewer.UninstallerHelper.plist
sudo launchctl unload /Library/LaunchDaemons/com.teamviewer.UninstallerWatcher.plist
sudo rm /Library/LaunchDaemons/com.teamviewer.*
sudo rm /Library/PrivilegedHelperTools/com.teamviewer.Helper
sudo rm -rf /Library/Application\ Support/TeamViewer
rm -rf ~/Library/Application\ Support/TeamViewer
rm -rf ~/Library/Caches/com.teamviewer.*
rm -rf ~/Library/Preferences/com.teamviewer*
rm -rf ~/Library/Logs/TeamViewer
\`\`\`
4. Verify nothing remains:
\`\`\`
ls /Library/LaunchDaemons/com.teamviewer* 2>/dev/null && echo 'STILL PRESENT' || echo 'Clean'
\`\`\`"
            show_fix "Uninstall TeamViewer (run this single block)" \
                "osascript -e 'quit app \"TeamViewer\"' 2>/dev/null; sudo launchctl unload /Library/LaunchDaemons/com.teamviewer.*.plist 2>/dev/null; sudo rm -f /Library/LaunchDaemons/com.teamviewer.* && sudo rm -f /Library/PrivilegedHelperTools/com.teamviewer.Helper && sudo rm -rf '/Library/Application Support/TeamViewer' && sudo rm -rf /Applications/TeamViewer.app && rm -rf ~/Library/Application\\ Support/TeamViewer ~/Library/Caches/com.teamviewer.* ~/Library/Preferences/com.teamviewer* ~/Library/Logs/TeamViewer; echo 'TeamViewer removed.'"
        else
            medium "Third-party LaunchDaemons found (run as root)" \
"Review these for legitimacy — any of them could be a persistence backdoor:

$DAEMON_LIST

\`\`\`
Fix: Investigate each one. Remove any that are not needed:
     sudo launchctl unload /Library/LaunchDaemons/<plist>
     sudo rm /Library/LaunchDaemons/<plist>
\`\`\`"
            show_fix "Remove unwanted LaunchDaemons (example)" \
                "sudo launchctl unload /Library/LaunchDaemons/<plist-name>" \
                "sudo rm /Library/LaunchDaemons/<plist-name>"
        fi

        # These run as root. Naming them in the terminal costs three lines and
        # saves opening the report to find out which ones they are.
        while IFS= read -r daemon; do
            [[ -z "$daemon" ]] && continue
            qprint "          - %s\n" "$daemon"
        done <<< "$THIRD_PARTY_DAEMONS"
    else
        pass "No third-party LaunchDaemons"
    fi

    # ── User LaunchAgents ──
    USER_AGENTS=$(ls ~/Library/LaunchAgents/ 2>/dev/null || true)
    if [[ -n "$USER_AGENTS" ]]; then
        AGENT_COUNT=$(echo "$USER_AGENTS" | wc -l | tr -d ' ')

        # Every agent is listed, with the unrecognised ones marked. The
        # whitelist decides the severity, not what you are allowed to see:
        # anything that starts itself at login is worth reading even when it
        # is expected, and printing only the unknown ones hid the rest.
        AGENT_LIST=""
        UNKNOWN_AGENTS=""
        UNKNOWN_COUNT=0
        while IFS= read -r agent; do
            [[ -z "$agent" ]] && continue
            if is_known_agent "$agent"; then
                AGENT_LIST="${AGENT_LIST}  - ${agent}\n"
            else
                AGENT_LIST="${AGENT_LIST}  - ${agent}  <-- unknown\n"
                UNKNOWN_AGENTS="${UNKNOWN_AGENTS}  - ${agent}\n"
                UNKNOWN_COUNT=$(( UNKNOWN_COUNT + 1 ))
            fi
        done <<< "$USER_AGENTS"
        AGENT_LIST=$(printf '%b' "$AGENT_LIST")

        if (( UNKNOWN_COUNT > 0 )); then
            medium "$UNKNOWN_COUNT unknown user LaunchAgent(s) found (${AGENT_COUNT} total) — review for legitimacy" \
"Unknown agents (not in whitelist):
$(printf '%b' "$UNKNOWN_AGENTS")
All $AGENT_COUNT agents in ~/Library/LaunchAgents:
$AGENT_LIST

\"Unknown\" means only that the filename is not in this tool's whitelist of
common software — it is a prompt to look, not a verdict. To see what one
actually does:

\`\`\`
     cat ~/Library/LaunchAgents/<plist>            # what it runs, and when
     launchctl list | grep <label>                 # whether it is loaded now
\`\`\`

\`\`\`
Fix: Review each one. Remove unneeded agents:
     launchctl unload ~/Library/LaunchAgents/<plist>
     rm ~/Library/LaunchAgents/<plist>
\`\`\`"
            show_fix "Inspect an agent, then remove it if unwanted" \
                "cat ~/Library/LaunchAgents/<plist-name>" \
                "launchctl unload ~/Library/LaunchAgents/<plist-name>" \
                "rm ~/Library/LaunchAgents/<plist-name>"
        else
            pass "$AGENT_COUNT user LaunchAgents (all known/whitelisted)"
        fi

        # Printed in both branches: the inventory is the useful part.
        while IFS= read -r agent; do
            [[ -z "$agent" ]] && continue
            if is_known_agent "$agent"; then
                qprint "          - %s\n" "$agent"
            else
                qprint "          - %s  %b<-- unknown%b\n" "$agent" "$YELLOW" "$NC"
            fi
        done <<< "$USER_AGENTS"
    else
        pass "No user LaunchAgents"
    fi

    # ── Cron jobs ──
    CRON_JOBS=$(crontab -l 2>/dev/null || true)
    if [[ -n "$CRON_JOBS" ]]; then
        medium "Cron jobs found for current user" \
"$CRON_JOBS

\`\`\`
Fix: Review with: crontab -l
     Edit with:   crontab -e
\`\`\`"
        show_fix "Review cron jobs" \
            "crontab -l" \
            "# Edit with: crontab -e"
    else
        pass "No cron jobs"
    fi

    # ── Certificates / mkcert ──
    MKCERT_ROOT=""
    if cmd_exists mkcert; then
        MKCERT_ROOT=$(mkcert -CAROOT 2>/dev/null || true)
    fi
    if [[ -n "$MKCERT_ROOT" && -d "$MKCERT_ROOT" ]]; then
        CA_KEY="$MKCERT_ROOT/rootCA-key.pem"
        if [[ -f "$CA_KEY" ]]; then
            KEY_PERMS=$(stat -f "%Lp" "$CA_KEY" 2>/dev/null || echo "unknown")
            if [[ "$KEY_PERMS" != "600" ]]; then
                high "mkcert root CA key has loose permissions ($KEY_PERMS)" \
"mkcert has installed a local root CA. If the private key is stolen, an attacker can silently MITM all your HTTPS traffic.

CA root: $MKCERT_ROOT
Key permissions: $KEY_PERMS (should be 600)

\`\`\`
Fix: chmod 600 \"$CA_KEY\"
     If not actively using mkcert: mkcert -uninstall
\`\`\`"
                show_fix "Fix mkcert CA key permissions" \
                    "chmod 600 \"$CA_KEY\""
            else
                pass "mkcert CA key permissions are 600"
            fi
        fi
    else
        pass "No mkcert local CA detected"
    fi
}

check_software_safari() {
    local auto_open
    auto_open=$(defaults read com.apple.Safari AutoOpenSafeDownloads 2>/dev/null || echo "unknown")

    if [[ "$auto_open" == "1" ]]; then
        medium "Safari auto-opens 'safe' files after downloading" \
"Safari automatically opens files it considers 'safe' (PDFs, images, archives). Malicious files disguised as safe types can auto-execute.

\`\`\`
Fix: Safari > Settings > General > Uncheck 'Open safe files after downloading'
\`\`\`"
        show_fix "Disable Safari auto-open" \
            "defaults write com.apple.Safari AutoOpenSafeDownloads -bool false"
    else
        pass "Safari does not auto-open downloaded files"
    fi
}

check_software_secure_keyboard() {
    local ske
    ske=$(defaults read com.apple.Terminal SecureKeyboardEntry 2>/dev/null || echo "unknown")

    if [[ "$ske" == "1" ]]; then
        pass "Secure Keyboard Entry is enabled in Terminal"
    elif [[ "$ske" == "0" ]]; then
        medium "Secure Keyboard Entry is disabled in Terminal" \
"Without Secure Keyboard Entry, other applications can intercept keystrokes typed in Terminal, including passwords and commands.

\`\`\`
Fix: Terminal > Secure Keyboard Entry (menu bar) > Enable
     Or: defaults write com.apple.Terminal SecureKeyboardEntry -bool true
\`\`\`"
        show_fix "Enable Secure Keyboard Entry" \
            "defaults write com.apple.Terminal SecureKeyboardEntry -bool true"
    else
        pass "Secure Keyboard Entry: could not determine (may use a different terminal)"
    fi
}

check_software_docker() {
    if daemon_loaded com.docker.vmnetd 2>/dev/null || daemon_loaded com.docker.socket 2>/dev/null; then
        medium "Docker system daemons are installed (run as root)" \
"Docker's vmnetd and socket daemon run as root-level LaunchDaemons. Containers can be used for privilege escalation.

\`\`\`
Fix: Only run Docker when actively needed. Consider lighter alternatives like Colima.
\`\`\`"
        show_fix "Consider lighter alternatives" \
            "# Stop Docker Desktop when not in use" \
            "# Consider Colima: brew install colima"
    else
        pass "No Docker system daemons detected"
    fi
}

###############################################################################
# CHECKS — Additional Encryption
###############################################################################

check_encryption_recovery_key() {
    if ! fdesetup status 2>/dev/null | grep -q "On"; then
        pass "FileVault is off (recovery key check not applicable)"
        return
    fi

    # Both queries exit 11 with "requires root access" for a normal user, and
    # this tool never runs sudo. The old code folded that failure into the same
    # branch as a genuine "false", so the check reported a missing recovery key
    # on every Mac with FileVault on — it could not pass, ever.
    local has_personal has_institutional
    has_personal=$(fdesetup haspersonalrecoverykey 2>/dev/null || true)
    has_institutional=$(fdesetup hasinstitutionalrecoverykey 2>/dev/null || true)

    if echo "$has_personal" | grep -qi "true"; then
        pass "FileVault personal recovery key exists"
    elif echo "$has_institutional" | grep -qi "true"; then
        pass "FileVault institutional recovery key exists"
    elif [[ -z "$has_personal$has_institutional" ]]; then
        medium "FileVault recovery key could not be verified (the query needs root)" \
"FileVault is on, which is what matters most. Whether a *recovery key* also
exists cannot be read without root, and this tool never runs \`sudo\`, so this is
a prompt to check rather than a finding against your machine.

**Why it matters.** FileVault encrypts the whole disk. Your login password is
what normally unlocks it. If you forget that password — or the account gets
damaged — the only other way in is a recovery mechanism. Without one the data is
gone permanently; there is no reset, no support call, no back door. That is the
point of the encryption.

**macOS offers two, and they are not the same thing:**

  1. **iCloud unlock** — chosen during FileVault setup as \"Allow my iCloud
     account to unlock my disk\". Recovery goes through your Apple Account.
     Convenient, but it ties disk recovery to an online account, and
     \`haspersonalrecoverykey\` reports **false** for it — this is the usual
     reason the check looks alarming on a perfectly recoverable Mac.
  2. **Personal recovery key** — a 24-character code macOS shows you exactly
     once. Offline, self-contained, and yours to store.

**Check which one you have:**

\`\`\`
sudo fdesetup haspersonalrecoverykey      # true = a 24-character key exists
sudo fdesetup status                      # confirms FileVault itself is on
\`\`\`

**Create (or replace) a personal recovery key:**

\`\`\`
sudo fdesetup changerecovery -personal
\`\`\`

It asks for an admin password, then prints a new key. Two things to know before
you run it: the key is shown **once and never again**, and it **invalidates any
previous personal key** — an old one written down somewhere stops working the
moment you do this.

**Where to keep it.** A password manager entry, or on paper somewhere physically
safe. Not on the encrypted disk itself: if you cannot boot the Mac you cannot
read the key that unlocks it.

**Or use the GUI:** System Settings > Privacy & Security > FileVault > Turn Off,
then Turn On again, and choose \"Create a recovery key and do not use my iCloud
account\" when prompted. Slower — it re-encrypts — but it shows the key on screen."
        show_fix "Check whether a recovery key exists, then create one if not" \
            "sudo fdesetup haspersonalrecoverykey" \
            "sudo fdesetup changerecovery -personal"
    else
        high "No FileVault recovery key found" \
"Confirmed with root: this Mac has neither a personal nor an institutional
recovery key. Your login password is the only thing that can unlock the disk.
Forget it, or lose the account, and every byte on this machine is unrecoverable
— no reset, no support call, no back door. That is what the encryption is for.

**Fix it now:**

\`\`\`
sudo fdesetup changerecovery -personal
\`\`\`

It asks for an admin password and prints a 24-character key. It is shown **once
and never again**, and it invalidates any previous personal key.

**Store it off this disk** — a password manager, or paper somewhere physically
safe. A key saved onto the encrypted volume is useless: if you cannot boot the
Mac, you cannot read the file that would let you boot the Mac.

An alternative is iCloud unlock (System Settings > Privacy & Security >
FileVault), which recovers through your Apple Account instead. Convenient, but
it makes disk recovery depend on an online account staying accessible."
        show_fix "Create a FileVault recovery key" \
            "sudo fdesetup changerecovery -personal"
    fi
}

###############################################################################
# CHECKS — Additional System
###############################################################################

check_system_profiles() {
    local mdm_status
    mdm_status=$(profiles status -type enrollment 2>&1 || echo "")

    if echo "$mdm_status" | grep -qi "MDM enrollment.*Yes"; then
        medium "Device is enrolled in MDM (Mobile Device Management)" \
"An MDM server can remotely manage settings, install profiles, and enforce policies on this Mac. Verify this is expected.

\`\`\`
Fix: If unexpected on a personal device:
     System Settings > General > Device Management > Remove MDM profile
     Note: DEP/ADE enrolled devices may require a full wipe to remove MDM
\`\`\`"
        show_fix "Review MDM enrollment" \
            "profiles status -type enrollment"
    else
        pass "Device is not enrolled in MDM"
    fi

    local user_profiles
    user_profiles=$(profiles list 2>&1 || echo "")

    if echo "$user_profiles" | grep -qi "no configuration profiles installed\|no profiles\|returned 0 records"; then
        pass "No configuration profiles installed"
    elif echo "$user_profiles" | grep -qi "error\|unable\|not allowed"; then
        pass "Configuration profiles: could not query (check manually)"
    elif [[ -n "$user_profiles" ]]; then
        medium "Configuration profiles installed — review for legitimacy" \
"Installed configuration profiles can modify system settings, enforce restrictions, or route network traffic through third-party servers. Malicious profiles can enable surveillance.

\`\`\`
Fix: System Settings > General > Device Management > review each profile
     profiles list   # to see all installed profiles
\`\`\`"
        show_fix "Review configuration profiles" \
            "profiles list"
    else
        pass "No configuration profiles installed"
    fi
}

check_system_mrt() {
    local found=false

    # XProtect Remediator (macOS Ventura+) supersedes MRT
    local xpr_path="/Library/Apple/System/Library/CoreServices/XProtect.app"
    if [[ -d "$xpr_path" ]]; then
        local xpr_version
        xpr_version=$(defaults read "$xpr_path/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "unknown")
        pass "XProtect Remediator installed (version: ${xpr_version})"
        found=true
    fi

    # MRT (legacy, pre-Ventura)
    local mrt_path="/Library/Apple/System/Library/CoreServices/MRT.app"
    if [[ -d "$mrt_path" ]]; then
        local mrt_version
        mrt_version=$(defaults read "$mrt_path/Contents/Info.plist" CFBundleShortVersionString 2>/dev/null || echo "unknown")
        pass "MRT installed (version: ${mrt_version})"
        found=true
    fi

    if ! $found; then
        medium "Neither MRT nor XProtect Remediator found" \
"These are macOS's background malware removal tools. At least one should be present on any supported Mac.

\`\`\`
Fix: System Settings > General > Software Update > check for updates
     sudo softwareupdate --background-critical
\`\`\`"
        show_fix "Check for system updates" \
            "sudo softwareupdate --background-critical"
    fi
}

###############################################################################
# CHECKS — Additional Auth
###############################################################################

check_auth_password_policy() {
    local policy_xml
    policy_xml=$(pwpolicy getaccountpolicies 2>/dev/null || echo "")

    if [[ -z "$policy_xml" ]] || echo "$policy_xml" | grep -qi "no account policies" || ! echo "$policy_xml" | grep -q "policyContent"; then
        medium "No custom password policy configured" \
"macOS defaults allow any password length and complexity. Without a policy, weak passwords like '1234' are accepted.

\`\`\`
Fix: For personal use: set a strong password (12+ characters, mixed types)
     System Settings > Touch ID & Password > Change Password
     For enterprise: use an MDM solution to enforce password policies
\`\`\`"
        show_fix "Set a strong password" \
            "# System Settings > Touch ID & Password > Change Password" \
            "# Recommend: 12+ characters with uppercase, lowercase, numbers, symbols"
    else
        pass "Password policy is configured"
    fi
}

###############################################################################
# CHECKS — Additional Privacy
###############################################################################

check_privacy_tcc() {
    local tcc_db="$HOME/Library/Application Support/com.apple.TCC/TCC.db"
    local issues=""
    local tcc_readable=false

    if [[ -f "$tcc_db" ]]; then
        # Test if we can actually read the database
        if sqlite3 "$tcc_db" "SELECT COUNT(*) FROM access LIMIT 1;" &>/dev/null; then
            tcc_readable=true
            local sensitive_services=("kTCCServiceCamera" "kTCCServiceMicrophone" "kTCCServiceScreenCapture" "kTCCServiceAccessibility" "kTCCServiceSystemPolicyAllFiles")
            local friendly_names=("Camera" "Microphone" "Screen Recording" "Accessibility" "Full Disk Access")

            for i in "${!sensitive_services[@]}"; do
                local service="${sensitive_services[$i]}"
                local friendly="${friendly_names[$i]}"
                local count
                count=$(sqlite3 "$tcc_db" "SELECT COUNT(*) FROM access WHERE service='$service' AND allowed=1;" 2>/dev/null || echo "0")
                if [[ "$count" =~ ^[0-9]+$ ]] && (( count > 0 )); then
                    issues="${issues}  - ${friendly}: ${count} app(s) granted access\n"
                fi
            done
        fi
    fi

    if [[ -n "$issues" ]]; then
        medium "Sensitive privacy permissions granted to apps" \
"The following high-risk privacy permissions are active:

$(echo -e "$issues")
Review whether each app legitimately needs these permissions.

\`\`\`
Fix: System Settings > Privacy & Security > review each category
     Revoke access for apps that no longer need it
\`\`\`"
        show_fix "Review privacy permissions" \
            "Open System Settings > Privacy & Security > review Camera, Microphone, Screen Recording, Accessibility, Full Disk Access"
    elif $tcc_readable; then
        pass "No sensitive privacy permission grants detected"
    else
        pass "Privacy permissions: TCC database not readable (grant Full Disk Access to Terminal for detailed audit)"
    fi
}

###############################################################################
# CHECKS — Additional Software
###############################################################################

check_software_safari_privacy() {
    local issues=""

    # Fraudulent website warnings
    local warn_fraud
    warn_fraud=$(defaults read com.apple.Safari WarnAboutFraudulentWebsites 2>/dev/null || echo "unknown")
    if [[ "$warn_fraud" == "0" ]]; then
        issues="${issues}  - Fraudulent website warnings are OFF\n"
    fi

    # Do Not Track header
    local dnt
    dnt=$(defaults read com.apple.Safari SendDoNotTrackHTTPHeader 2>/dev/null || echo "unknown")
    if [[ "$dnt" == "0" ]]; then
        issues="${issues}  - Do Not Track HTTP header is not sent\n"
    fi

    # Search engine
    local search_engine
    search_engine=$(defaults read com.apple.Safari SearchProviderShortName 2>/dev/null || echo "unknown")
    if [[ "$search_engine" != "unknown" ]] && ! echo "$search_engine" | grep -qiE "DuckDuckGo|Ecosia|Startpage"; then
        issues="${issues}  - Search engine: ${search_engine} (consider a privacy-focused alternative)\n"
    fi

    if [[ -n "$issues" ]]; then
        medium "Safari privacy settings could be improved" \
"$(echo -e "$issues")
\`\`\`
Fix: Safari > Settings > Privacy > enable tracking prevention
     Safari > Settings > Search > choose DuckDuckGo or other privacy-focused engine
     Safari > Settings > Security > enable fraudulent website warnings
\`\`\`"
        show_fix "Harden Safari privacy" \
            "defaults write com.apple.Safari WarnAboutFraudulentWebsites -bool true" \
            "defaults write com.apple.Safari SendDoNotTrackHTTPHeader -bool true"
    else
        pass "Safari privacy settings appear reasonable"
    fi
}

###############################################################################
# CHECKS — trust, persistence and third-party code (added in v3.1.0)
###############################################################################

# A certificate you told macOS to trust can impersonate any site on the
# internet, and nothing in the browser UI says so — the padlock looks the same.
# Development tooling installs these routinely (mkcert, Charles, mitmproxy,
# Proxyman) and uninstalling the tool does not remove the certificate.
check_system_trusted_roots() {
    local domain flag out lines idx name rt risk key j found
    local -a CERT_KEY=() CERT_NAME=() CERT_RISK=()
    local roots=0 others=0 denies=0 listing="" root_names="" other_names=""

    # Two domains are read: admin (system-wide, changing it needs an admin
    # password) and user (this login only). The *system* domain is Apple's
    # shipped root store — 150-odd certificates that are supposed to be there —
    # so enumerating it would bury the four that someone actually added.
    for domain in admin user; do
        if [[ "$domain" == "admin" ]]; then flag="-d"; else flag=""; fi
        # No trust settings at all is an error exit, not an empty success.
        out=$(security dump-trust-settings $flag 2>/dev/null || true)
        [[ -z "$out" ]] && continue

        # A cert line is emitted even when the certificate has no Result Type,
        # so a certificate can never drop out of the report just because macOS
        # printed its trust settings in the shorter form.
        lines=$(printf '%s\n' "$out" | awk '
            /^Cert [0-9]+:/ { idx = $2; sub(/:$/, "", idx); name = $0; sub(/^Cert [0-9]+: /, "", name); next }
            /Number of trust settings/ {
                if (name == "") next
                if ($NF == "0") print idx "|" name "|none"      # listed, but nothing customised
                else            print idx "|" name "|"          # placeholder; a Result Type may follow
            }
            /Result Type/   { if (name != "") print idx "|" name "|" $NF }
        ')
        [[ -z "$lines" ]] && continue

        while IFS='|' read -r idx name rt; do
            [[ -z "$idx" ]] && continue
            key="${domain}/${idx}"
            risk=$(trust_result_risk "$rt")
            found=-1
            for (( j = 0; j < ${#CERT_KEY[@]}; j++ )); do
                if [[ "${CERT_KEY[$j]}" == "$key" ]]; then found=$j; break; fi
            done
            if (( found < 0 )); then
                CERT_KEY+=("$key"); CERT_NAME+=("$name"); CERT_RISK+=("$risk")
            elif (( $(trust_risk_rank "$risk") > $(trust_risk_rank "${CERT_RISK[found]}") )); then
                CERT_RISK[found]="$risk"
            fi
        done <<< "$lines"
    done

    for (( j = 0; j < ${#CERT_KEY[@]}; j++ )); do
        domain="${CERT_KEY[$j]%%/*}"
        case "${CERT_RISK[$j]}" in
            root)
                roots=$((roots + 1))
                root_names="${root_names}  - ${CERT_NAME[$j]} (${domain} domain) — trusted as a root CA\n"
                listing="${listing}  - ${CERT_NAME[$j]} (${domain})  <-- trusted as a root CA\n" ;;
            leaf)
                others=$((others + 1))
                other_names="${other_names}  - ${CERT_NAME[$j]} (${domain} domain) — trusted as a single certificate\n"
                listing="${listing}  - ${CERT_NAME[$j]} (${domain})  <-- trusted as a single certificate\n" ;;
            unstated)
                others=$((others + 1))
                other_names="${other_names}  - ${CERT_NAME[$j]} (${domain} domain) — custom trust settings, result type not stated\n"
                listing="${listing}  - ${CERT_NAME[$j]} (${domain})  <-- custom trust settings\n" ;;
            deny)
                denies=$((denies + 1))
                listing="${listing}  - ${CERT_NAME[$j]} (${domain})  (explicitly distrusted)\n" ;;
            *)
                # 'none' — the certificate is in the keychain and shows up in the
                # dump, but has no custom trust settings at all. Listed, because
                # a duplicate of a CA you did trust is worth seeing, and not
                # counted, because nothing was customised.
                listing="${listing}  - ${CERT_NAME[$j]} (${domain})  (no custom trust settings)\n" ;;
        esac
    done

    if (( roots > 0 )); then
        high "$(printf '%d certificate(s) are trusted as a root CA' "$roots")" \
"Whoever holds the private key for one of these certificates can issue a valid
certificate for any domain — your bank, your company SSO, anything — and your
Mac will accept it silently. No browser warning appears, because from macOS's
point of view the certificate really is trusted.

$(printf '%b' "$root_names")
This is normal on a development machine (mkcert, Charles Proxy, mitmproxy and
Proxyman all install one) and it is also exactly what a working man-in-the-middle
looks like. The question worth answering for each one is: did you install it,
is the tool still in use, and is its private key still on this disk?

Review or remove them in Keychain Access > System (or Login) > Certificates:
select the certificate, open Get Info, and set 'When using this certificate'
back to 'Use System Defaults', or delete it outright. mkcert's own CA can be
removed with 'mkcert -uninstall'."
        # Breakdown after the summary, before the fix block — the fix commands
        # belong at the end, not wedged between a finding and its evidence.
        qprint "%b" "${listing//  - /          - }"
        show_fix "List the certificates you have trusted, then review them" \
            "security dump-trust-settings -d" \
            "security dump-trust-settings" \
            "open -a 'Keychain Access'"
    elif (( others > 0 )); then
        medium "$(printf '%d certificate(s) have custom trust settings' "$others")" \
"None of these is trusted as a certificate authority, so the damage is bounded:
the exact certificate is accepted and nothing it signs inherits that trust.
Still worth knowing about — self-signed localhost and staging certificates end
up here and outlive the project that needed them.

$(printf '%b' "$other_names")
Where the result type is 'not stated', macOS printed the trust settings without
one. That is the shorter form the user domain uses; it means a custom setting
exists, and Keychain Access will show you which.

Review them in Keychain Access > Certificates > Get Info > 'When using this
certificate' > 'Use System Defaults'."
        qprint "%b" "${listing//  - /          - }"
        show_fix "List certificates with custom trust settings" \
            "security dump-trust-settings -d" \
            "security dump-trust-settings"
    elif (( denies > 0 )); then
        pass "$(printf 'No certificates are manually trusted (%d explicitly distrusted)' "$denies")"
    else
        pass "No certificates are manually trusted"
    fi
}

# LaunchAgents in /Library run at login for *every* account on the Mac, not just
# yours — check 33 covers ~/Library/LaunchAgents, which is a different set.
# Login and logout hooks are a deprecated mechanism that still works, runs as
# root, and appears nowhere in System Settings.
check_software_startup_items() {
    local agents agent count=0 unknown_count=0 unknown_list="" listing="" domain hook value
    local hooks=""

    agents=$(find /Library/LaunchAgents -maxdepth 1 -type f -name '*.plist' 2>/dev/null | awk -F/ '{print $NF}' | sort || true)

    if [[ -n "$agents" ]]; then
        while IFS= read -r agent; do
            [[ -z "$agent" ]] && continue
            count=$((count + 1))
            # Every agent is listed; the whitelist decides the severity, not what
            # you are allowed to see.
            if is_known_agent "$agent"; then
                listing="${listing}          - ${agent}\n"
            else
                unknown_count=$((unknown_count + 1))
                unknown_list="${unknown_list}  - ${agent}\n"
                listing="${listing}          - ${agent}  <-- unknown\n"
            fi
        done <<< "$agents"
    fi

    # Both the per-user domain and the machine-wide plist, because a hook set in
    # either one runs. The value is the path to a script; it is reported, since
    # the whole point of the finding is to say which script.
    for domain in com.apple.loginwindow /Library/Preferences/com.apple.loginwindow; do
        for hook in LoginHook LogoutHook; do
            value=$(defaults read "$domain" "$hook" 2>/dev/null || true)
            [[ -n "$value" ]] && hooks="${hooks}  - ${hook} (${domain}): ${value}\n"
        done
    done

    if [[ -n "$hooks" ]]; then
        high "Login/logout hook is configured" \
"A login hook is a script macOS runs as root every time someone logs in. Apple
deprecated the mechanism years ago and it appears in no System Settings pane, so
it is a comfortable place to hide: nobody looks there, and it survives reboots
and account changes.

$(printf '%b' "$hooks")
If you did not set this up deliberately, read the script before doing anything
else. Removing a hook is 'sudo defaults delete com.apple.loginwindow LoginHook'."
        show_fix "Inspect and remove the hook" \
            "defaults read com.apple.loginwindow LoginHook" \
            "sudo defaults delete com.apple.loginwindow LoginHook" \
            "sudo defaults delete com.apple.loginwindow LogoutHook"
    elif (( unknown_count > 0 )); then
        medium "$(printf '%d unrecognised system-wide LaunchAgent(s) (%d total)' "$unknown_count" "$count")" \
"These live in /Library/LaunchAgents and start automatically at login for every
account on this Mac, which is a wider reach than the per-user agents in check 33.

$(printf '%b' "$unknown_list")
Unrecognised does not mean malicious — the list of known-good agents in this tool
is short and most legitimate software is missing from it. Read each plist to see
what it launches: 'defaults read /Library/LaunchAgents/<name>.plist ProgramArguments'.

Not covered here: modern background items registered through SMAppService
(System Settings > General > Login Items & Extensions). Reading that database
requires root, and this tool never asks for it."
        qprint "%b" "$listing"
        show_fix "See what each agent launches" \
            "ls -la /Library/LaunchAgents/" \
            "defaults read /Library/LaunchAgents/<name>.plist ProgramArguments"
    elif (( count > 0 )); then
        pass "$(printf '%d system-wide LaunchAgent(s), all recognised' "$count")"
        qprint "%b" "$listing"
    else
        pass "No system-wide LaunchAgents and no login hooks"
    fi
}

# Every new terminal window executes these files. Anyone who can write to one of
# them gets code execution as you, every time, without a prompt.
SHELL_RC_FILES=(
    ".zshrc" ".zprofile" ".zshenv" ".zlogin" ".zlogout"
    ".bashrc" ".bash_profile" ".bash_login" ".profile"
)

check_software_shell_rc() {
    local f path mode writable="" suspicious="" checked=0

    for f in "${SHELL_RC_FILES[@]}"; do
        path="${HOME}/${f}"
        [[ -f "$path" ]] || continue
        checked=$((checked + 1))

        mode=$(stat -f '%Lp' "$path" 2>/dev/null || true)
        if mode_is_group_or_world_writable "$mode"; then
            writable="${writable}  - ~/${f} (mode ${mode})\n"
        fi

        # Only the file name and which pattern matched are ever reported. The
        # matching line is not printed and not stored: shell startup files are
        # where people keep API tokens, and a security report that leaks one has
        # made things worse.
        if grep -qE "(curl|wget)[^|]*\|[[:space:]]*(sudo[[:space:]]+)?[a-z]*sh" "$path" 2>/dev/null; then
            suspicious="${suspicious}  - ~/${f} pipes a download directly into a shell\n"
        fi
        if grep -qE "base64[[:space:]]+(-d|-D|--decode)" "$path" 2>/dev/null; then
            suspicious="${suspicious}  - ~/${f} decodes base64 at shell start\n"
        fi
    done

    # System-wide files run before yours and are writable only by root; their
    # permissions are the thing worth checking, not their contents.
    for path in /etc/zshrc /etc/zprofile /etc/zshenv /etc/bashrc /etc/profile; do
        [[ -f "$path" ]] || continue
        checked=$((checked + 1))
        mode=$(stat -f '%Lp' "$path" 2>/dev/null || true)
        if mode_is_group_or_world_writable "$mode"; then
            writable="${writable}  - ${path} (mode ${mode})\n"
        fi
    done

    if [[ -n "$writable" ]]; then
        high "Shell startup file is writable by group or others" \
"A shell startup file runs on every new terminal. If someone other than you can
write to it, they can run anything they like as you, silently, the next time you
open a terminal — and it will keep running for as long as the line stays there.

$(printf '%b' "$writable")
Fix with 'chmod 644 <file>' for your own files (or 'chmod go-w <file>'). For the
/etc files, this normally means something changed them during an install."
        show_fix "Remove group/other write permission" \
            "chmod go-w ~/.zshrc ~/.zprofile ~/.bash_profile" \
            "ls -la ~/.zshrc ~/.zprofile ~/.zshenv ~/.bashrc ~/.bash_profile"
    elif [[ -n "$suspicious" ]]; then
        medium "Shell startup file runs a pattern worth reading" \
"$(printf '%b' "$suspicious")
Neither pattern is malicious by itself — plenty of install instructions end in
'curl … | sh', and it is normal to keep one in a dotfile. Both are also how a
startup file fetches and runs code you have never read, on every terminal.

The matching line is deliberately not reproduced here, because these files
routinely contain API tokens. Open the file and read the line yourself."
        show_fix "Read the file and decide" \
            "grep -nE '(curl|wget).*\\|' ~/.zshrc ~/.zprofile ~/.bash_profile"
    elif (( checked > 0 )); then
        pass "$(printf '%d shell startup file(s) look clean' "$checked")"
    else
        pass "No shell startup files found"
    fi
}

# A NOPASSWD rule turns any code running as you into code running as root, with
# no password prompt to notice. /etc/sudoers itself is mode 0440 root:wheel and
# this tool never runs sudo, so only the drop-in directory is in reach — that is
# stated in the finding rather than papered over.
check_auth_sudoers() {
    local drop_ins entry path nopasswd="" listing="" count=0 unreadable=0

    if [[ -d /etc/sudoers.d ]]; then
        drop_ins=$(find /etc/sudoers.d -maxdepth 1 -type f 2>/dev/null | awk -F/ '{print $NF}' | sort || true)
    else
        drop_ins=""
    fi

    if [[ -n "$drop_ins" ]]; then
        while IFS= read -r entry; do
            [[ -z "$entry" ]] && continue
            count=$((count + 1))
            path="/etc/sudoers.d/${entry}"
            listing="${listing}  - ${entry}\n"
            if [[ -r "$path" ]]; then
                if grep -q "NOPASSWD" "$path" 2>/dev/null; then
                    nopasswd="${nopasswd}  - ${entry}\n"
                fi
            else
                unreadable=$((unreadable + 1))
            fi
        done <<< "$drop_ins"
    fi

    if [[ -n "$nopasswd" ]]; then
        high "Passwordless sudo rule found in /etc/sudoers.d" \
"A NOPASSWD rule means sudo runs without asking for a password. Anything that can
run a command as you — a malicious npm postinstall, a compromised shell startup
file, a script you piped from the internet — becomes root without you typing
anything or seeing a prompt.

$(printf '%b' "$nopasswd")
Legitimate uses exist (CI runners, some installers). If you did not add it,
remove it. Only the file name is shown here; read the rule yourself with
'sudo cat /etc/sudoers.d/<name>' and edit it with 'sudo visudo -f'."
        show_fix "Review the rule and remove it if unexpected" \
            "sudo cat /etc/sudoers.d/<name>" \
            "sudo visudo -f /etc/sudoers.d/<name>"
    elif (( count > 0 )); then
        medium "$(printf '%d file(s) in /etc/sudoers.d extend sudo rules' "$count")" \
"Files dropped in this directory change who may run what as root, and installers
put them there without asking.

$(printf '%b' "$listing")
$(if (( unreadable > 0 )); then printf '%d of them could not be read as a normal user, so their rules were not inspected. ' "$unreadable"; fi)Read them with 'sudo cat /etc/sudoers.d/<name>'.

/etc/sudoers itself is only readable by root, so this check cannot see the main
rule set — including a NOPASSWD line placed there directly."
        show_fix "Read the drop-in rules" \
            "ls -la /etc/sudoers.d/" \
            "sudo cat /etc/sudoers.d/*"
    else
        pass "No custom sudo rules in /etc/sudoers.d"
    fi
}

# The login authorization chain is a list of mechanisms macOS runs inside the
# login window — the process the password is typed into. Enterprise tools
# legitimately insert themselves here (JAMF Connect, NoMAD, Okta), and so does
# anything that wants to see credentials in the clear.
check_auth_authplugins() {
    local mechs mech third_party="" bundles="" referenced="" listing="" plugin_dir
    plugin_dir="/Library/Security/SecurityAgentPlugins"

    mechs=$(security authorizationdb read system.login.console 2>/dev/null | awk '
        /<key>mechanisms<\/key>/ { inarr = 1; next }
        inarr && /<\/array>/     { exit }
        inarr && match($0, /<string>.*<\/string>/) { print substr($0, RSTART + 8, RLENGTH - 17) }
    ' || true)

    if [[ -n "$mechs" ]]; then
        while IFS= read -r mech; do
            [[ -z "$mech" ]] && continue
            login_mechanism_is_apple "$mech" || third_party="${third_party}  - ${mech}\n"
        done <<< "$mechs"
    fi

    if [[ -d "$plugin_dir" ]]; then
        bundles=$(find "$plugin_dir" -maxdepth 1 -name '*.bundle' 2>/dev/null | awk -F/ '{print $NF}' | sort || true)
        if [[ -f "${plugin_dir}/Component.plist" ]]; then
            referenced=$(awk 'match($0, /<string>.*\.bundle<\/string>/) { print substr($0, RSTART + 8, RLENGTH - 17) }' \
                "${plugin_dir}/Component.plist" 2>/dev/null | sort -u || true)
        fi
    fi

    [[ -n "$bundles"    ]] && listing="${listing}$(printf '%s\n' "$bundles"    | awk 'NF { print "  - " $0 " (installed)" }')"$'\n'
    [[ -n "$referenced" ]] && listing="${listing}$(printf '%s\n' "$referenced" | awk 'NF { print "  - " $0 " (registered in Component.plist)" }')"$'\n'

    if [[ -z "$mechs" ]]; then
        # A failed query is not evidence of a plugin, and reporting it as one
        # would be a false alarm.
        medium "Could not read the login authorization chain" \
"'security authorizationdb read system.login.console' returned nothing, so the
list of mechanisms that run at the login window could not be checked. Run it by
hand to see whether a third-party plugin is in the chain."
        show_fix "Read the login authorization chain" \
            "security authorizationdb read system.login.console"
    elif [[ -n "$third_party" ]]; then
        high "Third-party plugin is in the login authorization chain" \
"These mechanisms run inside the login window, which is where the password is
typed. A plugin there can see credentials in the clear.

$(printf '%b' "$third_party")
${listing:+Plugins on disk:
${listing}}
Enterprise identity tools (JAMF Connect, NoMAD, Okta Verify) belong here and are
expected on a managed Mac. Anything else should be traced back to something you
installed on purpose."
        qprint "%b" "${third_party//  - /          - }"
        show_fix "Inspect the chain and the plugin bundles" \
            "security authorizationdb read system.login.console" \
            "ls -la /Library/Security/SecurityAgentPlugins/"
    elif [[ -n "$listing" ]]; then
        medium "Authorization plugin(s) present but not in the login chain" \
"$(printf '%b' "$listing")
None of them appear in the mechanism list for system.login.console, so they do
not run at login as things stand. A bundle registered in Component.plist while
the bundle itself is gone is usually the residue of an uninstall — harmless, but
it is also a re-armed slot if the bundle ever comes back."
        qprint "%b" "${listing//  - /          - }"
        show_fix "Inspect the plugin directory" \
            "ls -la /Library/Security/SecurityAgentPlugins/" \
            "security authorizationdb read system.login.console"
    else
        pass "Login authorization chain is stock Apple mechanisms only"
    fi
}

# An extension with the right permissions reads every page you open, including
# the ones behind your bank's login. These are the permissions that make that
# possible; the common, low-signal ones (storage, alarms, contextMenus, and
# declarativeNetRequest, which every content blocker uses) are left out so the
# finding stays worth reading.
HIGH_IMPACT_EXTENSION_PERMISSIONS=(
    "<all_urls>" "debugger" "nativeMessaging" "proxy" "cookies"
    "webRequest" "management" "history" "desktopCapture" "tabCapture"
)

CHROMIUM_PROFILE_ROOTS=(
    "Google/Chrome" "Google/Chrome Beta" "Google/Chrome Canary" "Google/Chrome Dev"
    "Chromium" "BraveSoftware/Brave-Browser" "Microsoft Edge" "Vivaldi"
    "Arc/User Data" "Opera Software/Opera Stable"
)

check_software_browser_extensions() {
    local base root dir ext_dirs manifest ext_id ext_name perm hits seen j
    local msg_key msg_file default_locale locale
    local -a roots=() seen_ids=()
    local listing="" flagged="" count=0 flagged_count=0

    base="${HOME}/Library/Application Support"
    for root in "${CHROMIUM_PROFILE_ROOTS[@]}"; do
        [[ -d "${base}/${root}" ]] && roots+=("${base}/${root}")
    done

    if (( ${#roots[@]} == 0 )); then
        pass "No Chromium-family browser profiles found"
        return
    fi

    # Two bounded finds rather than one deep one: browser support directories
    # hold hundreds of thousands of cache files, and walking them would stall
    # the audit for seconds with nothing to show for it.
    ext_dirs=$(find "${roots[@]}" -maxdepth 3 -type d -name Extensions 2>/dev/null || true)
    [[ -z "$ext_dirs" ]] && { pass "No browser extensions installed"; return; }

    while IFS= read -r dir; do
        [[ -z "$dir" ]] && continue
        while IFS= read -r manifest; do
            [[ -z "$manifest" ]] && continue

            # <Extensions>/<id>/<version>/manifest.json
            ext_id=$(printf '%s' "$manifest" | awk -F/ '{print $(NF-2)}')

            # The same extension installed in two profiles, or two browsers, is
            # one extension. Counting it twice would inflate every number in the
            # finding.
            seen=false
            for (( j = 0; j < ${#seen_ids[@]}; j++ )); do
                if [[ "${seen_ids[$j]}" == "$ext_id" ]]; then seen=true; break; fi
            done
            $seen && continue
            seen_ids+=("$ext_id")
            count=$((count + 1))

            # Only a top-level "name" is used (indented at most four spaces);
            # nested objects in a manifest have a "name" too, and a minified
            # manifest has no usable indentation at all.
            ext_name=$(awk '
                { indent = match($0, /[^ ]/) - 1 }
                indent <= 4 && match($0, /"name"[[:space:]]*:[[:space:]]*"/) {
                    s = substr($0, RSTART + RLENGTH)
                    sub(/".*$/, "", s)
                    print s; exit
                }
            ' "$manifest" 2>/dev/null || true)

            # A localised extension stores "__MSG_appName__" in the manifest and
            # the real string in _locales. Without this, half the report is hex
            # identifiers.
            if [[ "$ext_name" == __MSG_*__ ]]; then
                msg_key="${ext_name#__MSG_}"; msg_key="${msg_key%__}"
                ext_name=""
                # The extension's own default_locale first, then the two English
                # spellings. Chrome ships an _locales/en that does not always
                # contain the key — stopping at the first *existing* file leaves
                # the name unresolved, so the loop stops at the first *answer*.
                default_locale=$(awk '
                    match($0, /"default_locale"[[:space:]]*:[[:space:]]*"/) {
                        s = substr($0, RSTART + RLENGTH); sub(/".*$/, "", s); print s; exit
                    }' "$manifest" 2>/dev/null || true)
                for locale in "$default_locale" en_US en; do
                    [[ -n "$locale" ]] || continue
                    msg_file="${manifest%/manifest.json}/_locales/${locale}/messages.json"
                    [[ -f "$msg_file" ]] || continue
                    ext_name=$(awk -v key="\"${msg_key}\"" '
                        { p = index($0, key) }
                        p > 0 {
                            rest = substr($0, p)
                            if (match(rest, /"message"[[:space:]]*:[[:space:]]*"/)) {
                                s = substr(rest, RSTART + RLENGTH); sub(/".*$/, "", s); print s; exit
                            }
                            found = 1; next
                        }
                        found && match($0, /"message"[[:space:]]*:[[:space:]]*"/) {
                            s = substr($0, RSTART + RLENGTH); sub(/".*$/, "", s); print s; exit
                        }
                    ' "$msg_file" 2>/dev/null || true)
                    [[ -n "$ext_name" ]] && break
                done
            fi
            # Falling back to the extension ID is correct, not a failure: the ID
            # is what chrome://extensions and the Web Store URL both use.
            [[ -z "$ext_name" || "$ext_name" == __MSG_* ]] && ext_name="$ext_id"

            hits=""
            for perm in "${HIGH_IMPACT_EXTENSION_PERMISSIONS[@]}"; do
                if grep -qF "\"${perm}\"" "$manifest" 2>/dev/null; then
                    hits="${hits}${hits:+, }${perm}"
                fi
            done

            if [[ -n "$hits" ]]; then
                flagged_count=$((flagged_count + 1))
                flagged="${flagged}  - ${ext_name} [${ext_id}] — ${hits}\n"
                listing="${listing}  - ${ext_name}  <-- ${hits}\n"
            else
                listing="${listing}  - ${ext_name}\n"
            fi
        done <<< "$(find "$dir" -maxdepth 3 -type f -name manifest.json 2>/dev/null || true)"
    done <<< "$ext_dirs"

    if (( flagged_count > 0 )); then
        medium "$(printf '%d of %d browser extension(s) declare high-impact permissions' "$flagged_count" "$count")" \
"An extension with these permissions can read and modify the pages you visit,
including your email and your bank. That is also what a legitimate password
manager or ad blocker needs, so the permission itself is not the finding — the
question is whether you recognise every extension in this list and still use it.

$(printf '%b' "$flagged")
The scan matches the permission string anywhere in manifest.json, so an optional
or narrowly-scoped declaration is reported the same as a blanket one. Open the
manifest to see the real scope, or the browser's own extension page, which shows
it in plain language:
  chrome://extensions  →  Details  →  'Site access' and 'Permissions'

Not covered: Firefox (extensions are packed in .xpi archives) and Safari (its
extensions are app bundles, listed under Safari > Settings > Extensions)."
        qprint "%b" "${listing//  - /          - }"
        show_fix "Review each extension in the browser" \
            "open -a 'Google Chrome' chrome://extensions" \
            "ls -1 \$HOME/Library/Application\\ Support/Google/Chrome/*/Extensions"
    elif (( count > 0 )); then
        pass "$(printf '%d browser extension(s), none declaring high-impact permissions' "$count")"
        qprint "%b" "${listing//  - /          - }"
    else
        pass "No browser extensions installed"
    fi
}

###############################################################################
# REPORT RENDERERS
###############################################################################

# Markdown table cells must not contain a bare pipe.
md_cell() { printf '%s' "${1//|/\\|}"; }

# Renders   "new": [{"check_number":12,"severity":"high","summary":"…"}]
# from the "<check>|<severity>|<summary>" lines the diff produces. The summary
# arrives already JSON-escaped — that is the form it was compared in — so it is
# emitted verbatim rather than escaped a second time.
render_json_diff_array() {
    local key="$1" line first=true
    shift
    printf '    "%s": [' "$key"
    for line in "$@"; do
        $first || printf ','
        first=false
        printf '{"check_number":%d,"severity":"%s","summary":"%s"}' \
            "$(diff_line_field "$line" num)" \
            "$(diff_line_field "$line" sev)" \
            "$(diff_line_field "$line" summary)"
    done
    printf ']'
}

render_json() {
    local i n c cn fix_json
    n=${#F_SEV[@]}
    printf '{\n'
    printf '  "version": "%s",\n' "$VERSION"
    printf '  "timestamp": "%s",\n' "$TIMESTAMP"
    printf '  "machine": {\n'
    printf '    "model": "%s",\n' "$(json_escape "$HW_MODEL")"
    printf '    "chip": "%s",\n' "$(json_escape "$HW_CHIP")"
    printf '    "macos_version": "%s",\n' "$(json_escape "$OS_VERSION")"
    printf '    "build": "%s",\n' "$(json_escape "$OS_BUILD")"
    printf '    "serial": "%s"\n' "$(json_escape "$SERIAL_OUT")"
    printf '  },\n'
    printf '  "score": %d,\n' "$SCORE"
    printf '  "grade": "%s",\n' "$GRADE"
    printf '  "offline": %s,\n' "$($ONLINE_MODE && printf 'false' || printf 'true')"
    printf '  "partial_audit": %s,\n' "$PARTIAL_AUDIT"
    if $PARTIAL_AUDIT; then
        printf '  "categories_checked": "%s",\n' "$(json_escape "$CATEGORY_FILTER")"
    else
        printf '  "categories_checked": "all",\n'
    fi
    printf '  "summary": {\n'
    printf '    "critical": %d,\n' "${#CRITICALS[@]}"
    printf '    "high": %d,\n' "${#HIGHS[@]}"
    printf '    "medium": %d,\n' "${#MEDIUMS[@]}"
    printf '    "pass": %d,\n' "${#PASSES[@]}"
    printf '    "checks_run": %d,\n' "$CHECKS_RUN"
    printf '    "total": %d\n' "$ACTIVE_CHECKS"
    printf '  },\n'
    printf '  "attack_chains": [\n'
    cn=${#CHAIN_TITLES[@]}
    for (( c = 0; c < cn; c++ )); do
        printf '    {"title":"%s","detail":"%s"}' \
            "$(json_escape "${CHAIN_TITLES[$c]}")" \
            "$(json_escape "${CHAIN_BODIES[$c]}")"
        if (( c < cn - 1 )); then printf ',\n'; else printf '\n'; fi
    done
    printf '  ],\n'
    if [[ -n "$BASELINE_FILE" ]]; then
        printf '  "baseline": {\n'
        printf '    "file": "%s",\n' "$(json_escape "$BASELINE_FILE")"
        printf '    "timestamp": "%s",\n' "$(json_escape "$BASELINE_TIMESTAMP")"
        if [[ "$BASELINE_SCORE" =~ ^[0-9]+$ ]]; then
            printf '    "score": %d,\n' "$BASELINE_SCORE"
        else
            printf '    "score": null,\n'
        fi
        printf '    "grade": "%s",\n' "$(json_escape "$BASELINE_GRADE")"
        render_json_diff_array "new" ${BASELINE_NEW[@]+"${BASELINE_NEW[@]}"}
        printf ',\n'
        render_json_diff_array "resolved" ${BASELINE_GONE[@]+"${BASELINE_GONE[@]}"}
        printf '\n  },\n'
    else
        printf '  "baseline": null,\n'
    fi
    printf '  "findings": [\n'
    for (( i = 0; i < n; i++ )); do
        fix_json="null"
        if [[ -n "${F_FIX[$i]}" ]]; then
            fix_json="\"$(json_escape "${F_FIX[$i]}")\""
        fi
        printf '    {"check_number":%d,"category":"%s","title":"%s","severity":"%s","summary":"%s","detail":"%s","fix":%s}' \
            "${F_NUM[$i]}" \
            "$(json_escape "${F_CAT[$i]}")" \
            "$(json_escape "${F_TITLE[$i]}")" \
            "${F_SEV[$i]}" \
            "$(json_escape "${F_SUMMARY[$i]}")" \
            "$(json_escape "${F_DETAIL[$i]}")" \
            "$fix_json"
        if (( i < n - 1 )); then printf ',\n'; else printf '\n'; fi
    done
    printf '  ]\n'
    printf '}\n'
}

render_markdown() {
    local p c h m idx i
    cat <<EOF
# macOS Security Audit Report

**Machine:** ${HW_MODEL} (${HW_CHIP})
**macOS:** ${OS_VERSION} (${OS_BUILD})
**Serial:** ${SERIAL_OUT}
**Date:** ${DATE_STAMP}
**Overall Grade:** ${GRADE} (${SCORE}/100)
EOF

    if $PARTIAL_AUDIT; then
        printf "\n> **Partial audit** — only categories: %s\n" "$CATEGORY_FILTER"
    fi
    if ! $ONLINE_MODE; then
        printf "\n> Run fully offline — no network request was made. Pending-update data comes from the values macOS cached at its own last check.\n"
    fi

    if (( ${#CHAIN_TITLES[@]} > 0 )); then
        printf '\n---\n\n## Attack Chains — Fix These Combinations First\n\n'
        printf 'Findings that are worse together than apart. These do not affect the score:\n'
        printf 'every finding referenced below is already counted once in its own check. What\n'
        printf 'they change is the order worth fixing things in.\n\n'
        for (( i = 0; i < ${#CHAIN_TITLES[@]}; i++ )); do
            printf '### %d. %s\n\n%s\n\n' "$(( i + 1 ))" "${CHAIN_TITLES[$i]}" "${CHAIN_BODIES[$i]}"
        done
    fi

    if [[ -n "$BASELINE_FILE" ]]; then
        printf '\n---\n\n## Changes Since Baseline\n\n'
        printf "Compared against \`%s\`" "$BASELINE_FILE"
        [[ -n "$BASELINE_TIMESTAMP" ]] && printf ' (%s)' "$BASELINE_TIMESTAMP"
        printf '.\nInformational only — the diff does not affect the score or the exit code.\n\n'
        if [[ -n "$BASELINE_SCORE" ]]; then
            printf '| | Baseline | Now |\n|---|---|---|\n'
            printf '| Score | %s | %s |\n' "$BASELINE_SCORE" "$SCORE"
            printf '| Grade | %s | %s |\n\n' "${BASELINE_GRADE:-?}" "$GRADE"
        fi
        if (( ${#BASELINE_NEW[@]} == 0 && ${#BASELINE_GONE[@]} == 0 )); then
            printf 'No change — the same findings on the same checks.\n'
        fi
        if (( ${#BASELINE_NEW[@]} > 0 )); then
            printf '### New\n\n'
            for (( i = 0; i < ${#BASELINE_NEW[@]}; i++ )); do
                printf -- '- %s\n' "$(format_diff_line "${BASELINE_NEW[$i]}")"
            done
            printf '\n'
        fi
        if (( ${#BASELINE_GONE[@]} > 0 )); then
            printf '### Resolved\n\n'
            for (( i = 0; i < ${#BASELINE_GONE[@]}; i++ )); do
                printf -- '- %s\n' "$(format_diff_line "${BASELINE_GONE[$i]}")"
            done
            printf '\n'
        fi
    fi

    cat <<'EOF'

---

## PASS — Strong Foundations

| Check | Status |
|---|---|
EOF

    # Guarded like the three severity sections below it: under `set -u`, bash 3.2
    # treats "${arr[@]}" on an empty array as an unbound variable, and a
    # --category run where nothing passes is not hypothetical.
    if (( ${#PASSES[@]} > 0 )); then
        for p in "${PASSES[@]}"; do
            printf "| %s | PASS |\n" "$(md_cell "$p")"
        done
    fi

    if (( ${#CRITICALS[@]} > 0 )); then
        printf '\n---\n\n## CRITICAL — Fix Immediately\n\n'
        idx=1
        for c in "${CRITICALS[@]}"; do
            printf "### %d. %s\n\n" "$idx" "$c"
            idx=$((idx + 1))
        done
    fi

    if (( ${#HIGHS[@]} > 0 )); then
        printf '\n---\n\n## HIGH — Fix Soon\n\n'
        idx=1
        for h in "${HIGHS[@]}"; do
            printf "### %d. %s\n\n" "$idx" "$h"
            idx=$((idx + 1))
        done
    fi

    if (( ${#MEDIUMS[@]} > 0 )); then
        printf '\n---\n\n## MEDIUM — Recommended Hardening\n\n'
        idx=1
        for m in "${MEDIUMS[@]}"; do
            printf "### %d. %s\n\n" "$idx" "$m"
            idx=$((idx + 1))
        done
    fi

    cat <<EOF

---

## Summary

| Severity | Count |
|---|---|
| PASS | ${#PASSES[@]} |
| CRITICAL | ${#CRITICALS[@]} |
| HIGH | ${#HIGHS[@]} |
| MEDIUM | ${#MEDIUMS[@]} |
| **Overall Grade** | **${GRADE}** (${SCORE}/100) |

---

*Generated by [macos-security-audit](https://github.com/fexxdev/macos_secuirty_audit) v${VERSION} on ${DATE_STAMP}*
EOF
}

###############################################################################
# MAIN EXECUTION
###############################################################################

main() {
    local entry num cat title fn line i

    ACTIVE_CHECKS=$(count_active_checks)
    if [[ -n "$CATEGORY_FILTER" ]]; then
        PARTIAL_AUDIT=true
    fi

    # ── Header ───────────────────────────────────────────────────────
    qecho ""
    qprint "${CYAN}╔══════════════════════════════════════════════════════╗${NC}\n"
    qprint "${CYAN}║         macOS Security Audit — %s            ║${NC}\n" "$DATE_STAMP"
    qprint "${CYAN}╚══════════════════════════════════════════════════════╝${NC}\n"
    qecho ""

    HW_MODEL=$(sysctl -n hw.model 2>/dev/null || echo "Unknown")
    HW_CHIP=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Chip/{print $2}' || echo "Unknown")
    OS_VERSION=$(sw_vers -productVersion 2>/dev/null || echo "Unknown")
    OS_BUILD=$(sw_vers -buildVersion 2>/dev/null || echo "Unknown")
    SERIAL=$(system_profiler SPHardwareDataType 2>/dev/null | awk -F': ' '/Serial Number/{print $2; exit}' || echo "Unknown")
    SERIAL_OUT="$SERIAL"
    $REDACT_MODE && SERIAL_OUT="REDACTED"
    TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)

    qprint "  Machine : %s (%s)\n" "$HW_MODEL" "$HW_CHIP"
    qprint "  macOS   : %s (%s)\n" "$OS_VERSION" "$OS_BUILD"
    qprint "  Serial  : %s\n" "$SERIAL_OUT"
    qprint "  Mode    : %s\n" "$($ONLINE_MODE && printf 'online (queries Apple for updates)' || printf 'offline (no network request)')"
    if $PARTIAL_AUDIT; then
        qprint "  Filter  : %s\n" "$CATEGORY_FILTER"
    fi
    qecho ""

    spin_start "Running security checks…"

    # ── Execute the checks, in registry order ────────────────────────
    for entry in "${CHECKS[@]}"; do
        IFS='|' read -r num cat title fn <<< "$entry"
        run_check "$num" "$cat" "$title" "$fn"
    done

    spin_stop

    # ── Terminal summary ─────────────────────────────────────────────
    (( SCORE < 0 )) && SCORE=0
    GRADE=$(letter_grade "$SCORE")

    evaluate_attack_chains

    # Computed after the grade and deliberately not fed back into it — see the
    # note above baseline_findings().
    if [[ -n "$BASELINE_FILE" ]]; then
        while IFS= read -r line; do
            [[ -n "$line" ]] && BASELINE_NEW+=("$line")
        done < <(comm -13 <(baseline_findings_active "$BASELINE_FILE" | sort) <(current_findings | sort))
        while IFS= read -r line; do
            [[ -n "$line" ]] && BASELINE_GONE+=("$line")
        done < <(comm -23 <(baseline_findings_active "$BASELINE_FILE" | sort) <(current_findings | sort))
        BASELINE_SCORE=$(baseline_meta "$BASELINE_FILE" score)
        BASELINE_GRADE=$(baseline_meta "$BASELINE_FILE" grade)
        BASELINE_TIMESTAMP=$(baseline_meta "$BASELINE_FILE" timestamp)
    fi

    if ! $QUIET_MODE; then
        echo ""
        qprint "${CYAN}┌─────────────────────────────────────┐${NC}\n"
        qprint "${CYAN}│       Security Audit Complete        │${NC}\n"
        qprint "${CYAN}├────────────┬────────────────────────┤${NC}\n"
        qprint "${CYAN}│${NC} ${RED}CRITICAL${NC}   ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "${#CRITICALS[@]}"
        qprint "${CYAN}│${NC} ${YELLOW}HIGH${NC}       ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "${#HIGHS[@]}"
        qprint "${CYAN}│${NC} ${YELLOW}MEDIUM${NC}     ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "${#MEDIUMS[@]}"
        qprint "${CYAN}│${NC} ${GREEN}PASS${NC}       ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "${#PASSES[@]}"
        qprint "${CYAN}├────────────┼────────────────────────┤${NC}\n"
        qprint "${CYAN}│${NC} Score      ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "$SCORE / 100"
        qprint "${CYAN}│${NC} Grade      ${CYAN}│${NC} %-22s ${CYAN}│${NC}\n" "$GRADE"
        qprint "${CYAN}└────────────┴────────────────────────┘${NC}\n"
        if $PARTIAL_AUDIT; then
            qprint "\n  ${YELLOW}Partial audit — categories: %s${NC}\n" "$CATEGORY_FILTER"
        fi
        echo ""
    else
        echo "$GRADE ($SCORE/100)"
    fi

    # ── Attack chains ────────────────────────────────────────────────
    if (( ${#CHAIN_TITLES[@]} > 0 )) && ! $QUIET_MODE; then
        qprint "  ${BOLD}${YELLOW}Attack chains — fix these combinations first${NC}\n"
        qprint "  These do not change the score. Every finding below is already counted.\n\n"
        for (( i = 0; i < ${#CHAIN_TITLES[@]}; i++ )); do
            qprint "  ${BOLD}%d. %s${NC}\n" "$(( i + 1 ))" "${CHAIN_TITLES[$i]}"
            qprint "%s\n\n" "     ${CHAIN_BODIES[$i]//$'\n'/$'\n'     }"
        done
    fi

    # ── Baseline diff ────────────────────────────────────────────────
    if [[ -n "$BASELINE_FILE" ]] && ! $QUIET_MODE; then
        qprint "  ${BOLD}Changes since baseline${NC} (%s)\n" "${BASELINE_TIMESTAMP:-unknown date}"
        if [[ -n "$BASELINE_SCORE" ]]; then
            qprint "  Score %s → %s    Grade %s → %s\n" \
                "$BASELINE_SCORE" "$SCORE" "${BASELINE_GRADE:-?}" "$GRADE"
        fi
        if (( ${#BASELINE_NEW[@]} == 0 && ${#BASELINE_GONE[@]} == 0 )); then
            qprint "  ${GREEN}No change${NC} — the same findings on the same checks.\n"
        fi
        for (( i = 0; i < ${#BASELINE_NEW[@]}; i++ )); do
            qprint "  ${RED}NEW${NC}       %s\n" "$(format_diff_line "${BASELINE_NEW[$i]}")"
        done
        for (( i = 0; i < ${#BASELINE_GONE[@]}; i++ )); do
            qprint "  ${GREEN}RESOLVED${NC}  %s\n" "$(format_diff_line "${BASELINE_GONE[$i]}")"
        done
        qecho ""
    fi

    # ── Report ───────────────────────────────────────────────────────
    if $JSON_MODE; then
        render_json > "$OUTPUT_FILE"
    else
        render_markdown > "$OUTPUT_FILE"
    fi

    if ! $QUIET_MODE; then
        if $JSON_MODE; then
            qprint "  ${GREEN}JSON report written to: %s${NC}\n" "$OUTPUT_FILE"
        else
            qprint "  ${GREEN}Report written to: %s${NC}\n" "$OUTPUT_FILE"
        fi
        qprint "  ${CYAN}Review the report:${NC} cat %s\n" "$OUTPUT_FILE"
        echo ""
    fi

    # ── Exit code based on grade ─────────────────────────────────────
    case "$GRADE" in
        A+|A|A-|B+|B|B-) return 0 ;;
        C+|C|C-)         return 1 ;;
        *)               return 2 ;;
    esac
}

if [[ "$MSA_LIB_MODE" != "1" ]]; then
    main
    exit $?
fi
